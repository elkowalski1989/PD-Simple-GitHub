<Project>
  <!-- Explicit compiler-only mode for maintainers. Normal consumers use packages.
       This does not copy a host or resident and cannot create a runnable release. -->
  <ItemGroup Condition="'$(PcbEngineSourceRoot)' != ''">
    <PackageReference Remove="PcbEngine.Native;PcbEngine;PcbEngine.Wpf;PcbEngine.Wpf.NativeHost;PcbEngine.Wpf.NativeHost.Integration" />
    <ProjectReference Include="$(PcbEngineSourceRoot)/src/PcbEngine/PcbEngine.csproj" />
    <ProjectReference Include="$(PcbEngineSourceRoot)/src/PcbEngine.Wpf/PcbEngine.Wpf.csproj"
                      Condition="'$(UseWPF)' == 'true'" />
    <ProjectReference Include="$(PcbEngineSourceRoot)/src/PcbEngine.Wpf.NativeHost/PcbEngine.Wpf.NativeHost.csproj"
                      Condition="'$(UseWPF)' == 'true'" />
  </ItemGroup>
  <Target Name="RejectSourceLinkedDistribution" BeforeTargets="Publish;Pack"
          Condition="'$(PcbEngineSourceRoot)' != ''">
    <Error Text="Compiler-only source references cannot be published. Build the matching Engine/WPF bundle and use the default package-only project." />
  </Target>
  <Target Name="MarkCompilerOnlyOutput" AfterTargets="Build"
          Condition="'$(PcbEngineSourceRoot)' != ''">
    <WriteLinesToFile File="$(TargetDir)COMPILER-ONLY.txt" Overwrite="true"
        Lines="Compiled against Bridge source. No matching protected host or resident is supplied. Not a runnable Allegro package." />
  </Target>
</Project>

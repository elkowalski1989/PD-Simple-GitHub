*.brd
*.dra
*.psm
*.pad
*.jrl
*.jrl,*
*.log
*.rpt
*.rpt.dat
*.zip

# Local credentials and signing material.
.env
.env.*
!.env.example
*.pfx
*.p12
*.pem
*.key

# Operating-system metadata.
.DS_Store
Thumbs.db
Desktop.ini

!packages/CircuitHub.AllegroBridge.Engine.*.nupkg

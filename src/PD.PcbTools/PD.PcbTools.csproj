<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Reusable engineering policy consumes Engine scenes/units only. Native
         session, transport and SDK DTO ownership remains below the Engine boundary. -->
    <PackageReference Include="CircuitHub.AllegroBridge.Engine" Version="[$(AllegroBridgeEnginePackageVersion)]" />
    <EmbeddedResource Include="SignalCategories.json" />
  </ItemGroup>
</Project>

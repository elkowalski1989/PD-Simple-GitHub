<?xml version='1.0' encoding='utf-8'?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PD.Simple</AssemblyName>
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PD.Simple.DrawingChecks"/>
    <PackageReference Include="CircuitHub.AllegroBridge.Sdk" Version="[1.12.0-preview.1]"/>
    <PackageReference Include="CircuitHub.AllegroBridge.Wpf" Version="[1.12.0-preview.1]"/>
    <AllegroBridgeSkill Include="Skill/**/*.il"/>
  </ItemGroup>
</Project>

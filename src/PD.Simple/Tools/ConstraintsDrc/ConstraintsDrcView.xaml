<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PD.Simple.Tools.ConstraintsDrc.ConstraintsDrcView"
             Background="#F5F8FD" Foreground="#17243B" FontSize="11">
  <UserControl.Resources>
    <Style x:Key="DrcCard" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#DCE7F5"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="DrcCaption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#59708E"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" MaxWidth="980">
      <TextBlock Text="{Binding StatusTitle}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4"
                 AutomationProperties.Name="Constraints DRC status title"/>
      <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource DrcCaption}" Margin="0,0,0,2"/>
      <TextBlock Text="{Binding BusyDetail}" Style="{StaticResource DrcCaption}" Margin="0,0,0,12"/>

      <Border Style="{StaticResource DrcCard}" AutomationProperties.Name="Constraint snapshot card">
        <StackPanel>
          <TextBlock Text="Constraint snapshot" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock Text="Snapshot browsing is offline-safe. Refresh issues a fresh native request; observing reuses the accepted session snapshot and never claims a refresh."
                     Style="{StaticResource DrcCaption}" Margin="0,0,0,8"/>
          <WrapPanel Margin="0,0,0,8">
            <Button x:Name="RefreshConstraintsButton" Content="Refresh constraints" Click="RefreshConstraints_Click"
                    IsEnabled="{Binding CanRefreshConstraints}" ToolTip="{Binding RefreshConstraintsReason}"
                    AutomationProperties.Name="Refresh constraint snapshot" Margin="0,0,8,4"/>
            <Button x:Name="ObserveConstraintsButton" Content="Observe snapshot" Click="ObserveConstraints_Click"
                    IsEnabled="{Binding CanRefreshConstraints}" ToolTip="{Binding RefreshConstraintsReason}"
                    AutomationProperties.Name="Observe accepted constraint snapshot" Margin="0,0,8,4"/>
            <Button x:Name="ReadEffectiveButton" Content="Read effective value" Click="ReadEffective_Click" IsEnabled="{Binding CanReadEffective}"
                    ToolTip="{Binding ReadEffectiveReason}" AutomationProperties.Name="Read effective constraint value" Margin="0,0,8,4"/>
            <Button x:Name="EditConstraintButton" Content="Prepare / execute edit" Click="EditConstraint_Click" IsEnabled="{Binding CanEditConstraints}"
                    ToolTip="{Binding EditConstraintsReason}" AutomationProperties.Name="Edit constraint value" Margin="0,0,8,4"/>
            <Button x:Name="RecoverEditButton" Content="Recover edit" Click="RecoverEdit_Click" IsEnabled="{Binding CanRecoverEdit}"
                    ToolTip="Starts Engine-owned recovery for the last mutation when recovery evidence exists. Recovery is never a replay."
                    AutomationProperties.Name="Recover constraint edit" Margin="0,0,8,4"/>
            <Button x:Name="CancelConstraintsButton" Content="Cancel" Click="Cancel_Click"
                    AutomationProperties.Name="Cancel Constraints DRC operation" Margin="0,0,0,4"/>
          </WrapPanel>
          <TextBlock Text="{Binding SnapshotSummary}" TextWrapping="Wrap" Margin="0,0,0,4"
                     AutomationProperties.Name="Constraint snapshot summary"/>
          <TextBlock Text="{Binding SnapshotCoverage}" Style="{StaticResource DrcCaption}" Margin="0,0,0,8"/>
          <TextBlock Text="Sets" FontWeight="SemiBold"/>
          <ListBox ItemsSource="{Binding SetRows}" DisplayMemberPath="Display" MaxHeight="140" Margin="0,2,0,8"
                   AutomationProperties.Name="Constraint sets"/>
          <TextBlock Text="Fields" FontWeight="SemiBold"/>
          <ListBox ItemsSource="{Binding FieldRows}" DisplayMemberPath="Display" MaxHeight="110" Margin="0,2,0,8"
                   AutomationProperties.Name="Constraint fields"/>
          <TextBlock Text="Assignments" FontWeight="SemiBold"/>
          <ListBox ItemsSource="{Binding AssignmentRows}" DisplayMemberPath="Display" MaxHeight="110" Margin="0,2,0,8"
                   AutomationProperties.Name="Constraint assignments"/>
          <TextBlock Text="Context assignments" FontWeight="SemiBold"/>
          <ListBox ItemsSource="{Binding ContextAssignmentRows}" DisplayMemberPath="Display" MaxHeight="110" Margin="0,2,0,8"
                   AutomationProperties.Name="Constraint context assignments"/>
          <TextBlock Text="Net classes" FontWeight="SemiBold"/>
          <ListBox ItemsSource="{Binding NetClassRows}" DisplayMemberPath="Display" MaxHeight="110" Margin="0,2,0,8"
                   AutomationProperties.Name="Constraint net classes"/>
          <TextBlock Text="Class-class spacing" FontWeight="SemiBold"/>
          <ListBox ItemsSource="{Binding ClassClassRows}" DisplayMemberPath="Display" MaxHeight="110" Margin="0,2,0,8"
                   AutomationProperties.Name="Constraint class class spacing"/>
          <TextBlock Text="Values (snapshot facts, not assigned/effective)" FontWeight="SemiBold"/>
          <WrapPanel Margin="0,2,0,4">
            <TextBox x:Name="ValueDomainFilterBox" Width="140" Margin="0,0,8,4"
                     Text="{Binding ValueDomainFilter, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Constraint value domain filter"/>
            <TextBox x:Name="ValueTextFilterBox" Width="220"
                     Text="{Binding ValueTextFilter, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Constraint value text filter"/>
          </WrapPanel>
          <ListBox ItemsSource="{Binding ValueRows}" DisplayMemberPath="Display" MaxHeight="180"
                   SelectedItem="{Binding SelectedValue}"
                   AutomationProperties.Name="Constraint values"/>
          <TextBlock Text="Effective facts and typed edits (assigned vs effective, never substituted)" FontWeight="SemiBold" Margin="0,8,0,2"/>
          <WrapPanel Margin="0,2,0,4">
            <TextBox x:Name="ScalarKindBox" Width="110" Margin="0,0,8,4"
                     Text="{Binding QueryKindText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Effective value kind (Number, Boolean, Symbol, Text)"/>
            <TextBox x:Name="ScalarUnitBox" Width="110" Margin="0,0,8,4"
                     Text="{Binding QueryUnitText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Effective value unit (Mils, Unitless)"/>
            <TextBox x:Name="NewValueBox" Width="140" Margin="0,0,8,4"
                     Text="{Binding NewValueText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="New typed constraint value"/>
            <TextBox x:Name="EditKindBox" Width="160"
                     Text="{Binding EditChangeKindText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Constraint change kind (SetValue, ResetValue, AssignElectricalSet, ResetElectricalAssignment)"/>
          </WrapPanel>
          <TextBlock Text="{Binding EffectiveSummary}" TextWrapping="Wrap" Margin="0,0,0,4"
                     AutomationProperties.Name="Effective constraint summary"/>
          <TextBlock Text="{Binding EditSummary}" TextWrapping="Wrap" Margin="0,0,0,4"
                     AutomationProperties.Name="Constraint edit summary"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource DrcCard}" AutomationProperties.Name="DRC marker review card">
        <StackPanel>
          <TextBlock Text="DRC markers" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock Text="Marker reads enumerate Allegro's existing DRC markers. Reading markers never runs DRC. Run DRC executes fresh native DRC for the full-board scope and reports completion with rule-scope evidence."
                     Style="{StaticResource DrcCaption}" Margin="0,0,0,8"/>
          <WrapPanel Margin="0,0,0,8">
            <Button x:Name="ReadMarkersButton" Content="Read DRC markers" Click="ReadMarkers_Click"
                    IsEnabled="{Binding CanReadMarkers}" ToolTip="{Binding ReadMarkersReason}"
                    AutomationProperties.Name="Read DRC markers" Margin="0,0,8,4"/>
            <Button x:Name="RunDrcButton" Content="Run DRC" Click="RunDrc_Click" IsEnabled="{Binding CanRunDrc}"
                    ToolTip="{Binding RunDrcReason}" AutomationProperties.Name="Run native DRC" Margin="0,0,8,4"/>
            <Button x:Name="CopyExportButton" Content="Copy export" Click="CopyExport_Click"
                    AutomationProperties.Name="Copy DRC marker export" Margin="0,0,8,4"/>
            <Button x:Name="CancelMarkersButton" Content="Cancel" Click="Cancel_Click"
                    AutomationProperties.Name="Cancel DRC marker operation" Margin="0,0,0,4"/>
          </WrapPanel>
          <TextBlock Text="{Binding DrcRunSummary}" TextWrapping="Wrap" Margin="0,0,0,4"
                     AutomationProperties.Name="Native DRC run summary"/>
          <TextBlock Text="{Binding MarkerSummary}" TextWrapping="Wrap" Margin="0,0,0,4"
                     AutomationProperties.Name="DRC marker summary"/>
          <TextBlock Text="{Binding ComparisonSummary}" Style="{StaticResource DrcCaption}" Margin="0,0,0,8"
                     AutomationProperties.Name="DRC capture comparison summary"/>
          <TextBlock Text="Groups (type / layer)" FontWeight="SemiBold"/>
          <ListBox ItemsSource="{Binding GroupRows}" DisplayMemberPath="Display" MaxHeight="110" Margin="0,2,0,8"
                   AutomationProperties.Name="DRC marker groups"/>
          <TextBlock Text="Markers" FontWeight="SemiBold"/>
          <WrapPanel Margin="0,2,0,4">
            <TextBox x:Name="MarkerTypeFilterBox" Width="160" Margin="0,0,8,4"
                     Text="{Binding MarkerTypeFilter, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="DRC marker type filter"/>
            <TextBox x:Name="MarkerLayerFilterBox" Width="140" Margin="0,0,8,4"
                     Text="{Binding MarkerLayerFilter, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="DRC marker layer filter"/>
            <TextBox x:Name="MarkerTextFilterBox" Width="180" Margin="0,0,8,4"
                     Text="{Binding MarkerTextFilter, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="DRC marker text filter"/>
            <CheckBox x:Name="IncludeWaivedBox" Content="Include waived" IsChecked="{Binding IncludeWaived}"
                      AutomationProperties.Name="Include waived DRC markers"/>
          </WrapPanel>
          <ListBox ItemsSource="{Binding MarkerRows}" DisplayMemberPath="Display"
                   SelectedItem="{Binding SelectedMarker}" MaxHeight="200"
                   AutomationProperties.Name="DRC markers"/>
          <TextBlock Text="{Binding SelectedMarkerDetail}" TextWrapping="Wrap" Margin="0,6,0,4"
                     AutomationProperties.Name="Selected DRC marker detail"/>
          <WrapPanel>
            <TextBox x:Name="ReviewNoteBox" Width="320" Margin="0,0,8,4"
                     AutomationProperties.Name="PD review note for selected marker"/>
            <Button x:Name="MarkReviewedButton" Content="Add PD review note" Click="MarkReviewed_Click"
                    IsEnabled="{Binding CanMarkReviewed}"
                    ToolTip="Records PD-local review state. A PD review note is never a native DRC waiver."
                    AutomationProperties.Name="Add PD review note"/>
          </WrapPanel>
          <TextBlock Text="Export preview" FontWeight="SemiBold" Margin="0,8,0,2"/>
          <TextBox Text="{Binding ExportText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto" MaxHeight="140" FontFamily="Consolas"
                   AutomationProperties.Name="DRC marker export preview"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

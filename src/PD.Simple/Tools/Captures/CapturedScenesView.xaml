<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PD.Simple.Tools.Captures.CapturedScenesView"
             Background="#F5F8FD"
             AutomationProperties.Name="Captured scenes task view">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" MaxWidth="980">
      <TextBlock Text="Captured scenes" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="Explicit capture, offline open and replay, export, and fresh reacquisition. Archives never grant live authority."
                 Foreground="#59708E" Margin="0,6,0,0"/>
      <TextBlock Text="{Binding SourceProvenance}" Foreground="#59708E" FontSize="11" Margin="0,4,0,0"/>
      <TextBlock Text="{Binding CoverageSummary}" Margin="0,8,0,0"/>
      <TextBlock Text="{Binding LiveAuthorityText}" FontWeight="SemiBold" Margin="0,2,0,0"/>
      <TextBlock Text="{Binding BulkInfoText}" Foreground="#59708E" Margin="0,2,0,0"/>

      <TextBlock Text="Capture options" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,8"/>
      <WrapPanel x:Name="FamilyPanel" Margin="0,0,0,8"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
        <CheckBox x:Name="ContoursBox" Content="Include contours" IsChecked="{Binding IncludeContours}"
                  AutomationProperties.Name="Include contour detail" VerticalContentAlignment="Center"/>
        <CheckBox x:Name="BulkBox" Content="Bulk capture path" IsChecked="{Binding UseBulkPath}" Margin="16,0,0,0"
                  AutomationProperties.Name="Use bulk capture path" VerticalContentAlignment="Center"/>
      </StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Layers (comma separated)" VerticalAlignment="Center" Margin="0,0,10,6"/>
        <TextBox x:Name="LayersInput" Grid.Column="1" Height="30" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,0,6"
                 Text="{Binding LayerNamesText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Capture layers"/>
        <TextBlock Grid.Row="1" Text="Region (mils X1 Y1 X2 Y2, optional)" VerticalAlignment="Center" Margin="0,0,10,6"/>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
          <TextBox x:Name="RegionX1Input" Width="80" Height="30" Padding="8,0" VerticalContentAlignment="Center"
                   Text="{Binding RegionX1Mils, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Capture region X1 mils"/>
          <TextBox x:Name="RegionY1Input" Width="80" Height="30" Padding="8,0" VerticalContentAlignment="Center" Margin="6,0,0,0"
                   Text="{Binding RegionY1Mils, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Capture region Y1 mils"/>
          <TextBox x:Name="RegionX2Input" Width="80" Height="30" Padding="8,0" VerticalContentAlignment="Center" Margin="6,0,0,0"
                   Text="{Binding RegionX2Mils, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Capture region X2 mils"/>
          <TextBox x:Name="RegionY2Input" Width="80" Height="30" Padding="8,0" VerticalContentAlignment="Center" Margin="6,0,0,0"
                   Text="{Binding RegionY2Mils, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Capture region Y2 mils"/>
          <Button x:Name="ClearRegionButton" Content="Clear region" Click="ClearRegion_Click" Margin="8,0,0,0"
                  AutomationProperties.Name="Clear capture region"/>
        </StackPanel>
        <TextBlock Grid.Row="2" Text="Budgets (objects, contour vertices)" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
          <TextBox x:Name="MaxObjectsInput" Width="100" Height="30" Padding="8,0" VerticalContentAlignment="Center"
                   Text="{Binding MaximumObjects, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Maximum captured objects"/>
          <TextBox x:Name="MaxContourInput" Width="100" Height="30" Padding="8,0" VerticalContentAlignment="Center" Margin="6,0,0,0"
                   Text="{Binding MaximumContourVertices, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Maximum contour vertices"/>
        </StackPanel>
      </Grid>

      <WrapPanel Margin="0,12,0,0">
        <Button x:Name="CaptureButton" Content="Capture now" Click="Capture_Click" Background="#147CF8" Foreground="White"
                AutomationProperties.Name="Capture scene now"/>
        <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" AutomationProperties.Name="Cancel scene operation"/>
        <Button x:Name="ReplayButton" Content="Replay bulk query" Click="Replay_Click" AutomationProperties.Name="Replay bulk capture"/>
        <Button x:Name="ReacquireButton" Content="Reacquire for live work" Click="Reacquire_Click" AutomationProperties.Name="Reacquire scene"/>
        <Button x:Name="CloseButton" Content="Close / release" Click="Close_Click" AutomationProperties.Name="Close scene"/>
      </WrapPanel>
      <TextBlock Text="{Binding CaptureBlockedReason}" Foreground="#8A5A00" Margin="0,6,0,0"/>
      <TextBlock Text="Progress diagnostics" FontWeight="SemiBold" Margin="0,12,0,4"/>
      <ListBox ItemsSource="{Binding ProgressDiagnostics}" Height="80" AutomationProperties.Name="Capture progress diagnostics">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Code}" FontWeight="SemiBold" Margin="0,0,8,0"/>
              <TextBlock Text="{Binding Message}" Foreground="#59708E"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Text="Archive and bulk files" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,8"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Button x:Name="SaveButton" Content="Save archive" Click="Save_Click" Margin="0,0,10,6" AutomationProperties.Name="Save scene archive"/>
        <TextBox x:Name="SavePathInput" Grid.Column="1" Height="30" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,10,6"
                 AutomationProperties.Name="Scene archive save path"/>
        <CheckBox x:Name="SaveOverwriteBox" Grid.Column="2" Content="Overwrite" VerticalContentAlignment="Center" Margin="0,0,0,6"
                  AutomationProperties.Name="Overwrite scene archive"/>
        <Button x:Name="OpenButton" Content="Open archive" Click="Open_Click" Margin="0,0,10,6" AutomationProperties.Name="Open scene archive"/>
        <TextBox x:Name="OpenPathInput" Grid.Column="1" Grid.Row="1" Height="30" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,10,6"
                 Grid.ColumnSpan="2" AutomationProperties.Name="Scene archive open path"/>
        <Button x:Name="ManifestButton" Content="Export manifest" Click="Manifest_Click" Grid.Row="2" Margin="0,0,10,6" AutomationProperties.Name="Export scene manifest"/>
        <TextBox x:Name="ManifestPathInput" Grid.Column="1" Grid.Row="2" Height="30" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,10,6"
                 AutomationProperties.Name="Scene manifest path"/>
        <CheckBox x:Name="ManifestOverwriteBox" Grid.Row="2" Grid.Column="2" Content="Overwrite" VerticalContentAlignment="Center" Margin="0,0,0,6"
                  AutomationProperties.Name="Overwrite scene manifest"/>
        <Button x:Name="OpenBulkButton" Content="Open bulk directory" Click="OpenBulk_Click" Grid.Row="3" Margin="0,0,10,0" AutomationProperties.Name="Open bulk directory"/>
        <TextBox x:Name="BulkPathInput" Grid.Column="1" Grid.Row="3" Height="30" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,10,0"
                 AutomationProperties.Name="Bulk directory path"/>
        <Button x:Name="ExportBulkButton" Content="Export bulk" Click="ExportBulk_Click" Grid.Row="3" Grid.Column="2" AutomationProperties.Name="Export bulk capture"/>
      </Grid>

      <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" Margin="0,16,0,0"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>

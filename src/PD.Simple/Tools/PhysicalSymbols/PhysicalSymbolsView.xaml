<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PD.Simple.Tools.PhysicalSymbols" x:Class="PD.Simple.Tools.PhysicalSymbols.PhysicalSymbolsView" Background="#F5F8FD" Foreground="#17243B" FontSize="11">
  <UserControl.Resources>
    <SolidColorBrush x:Key="SymInk" Color="#17243B"/>
    <SolidColorBrush x:Key="SymMuted" Color="#59708E"/>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SymInk}"/>
    </Style>
    <Style x:Key="SymCaption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SymMuted}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SymCard" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#DCE7F5"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="12"/>
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16" Orientation="Vertical">
      <TextBlock Text="Physical symbols" FontSize="16" FontWeight="SemiBold" AutomationProperties.AutomationId="PhysicalSymbols.Title"/>
      <TextBlock x:Name="SymModeLine" Style="{StaticResource SymCaption}" Margin="0,2,0,10" AutomationProperties.AutomationId="PhysicalSymbols.Mode"/>
      <Border Style="{StaticResource SymCard}" Margin="0,0,0,10">
        <StackPanel>
          <TextBlock Text="Staged PACKAGE work area" FontWeight="SemiBold" AutomationProperties.AutomationId="PhysicalSymbols.StageHeading"/>
          <TextBlock x:Name="SymStageDetail" Style="{StaticResource SymCaption}" Margin="0,6,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="PhysicalSymbols.StageDetail"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource SymCard}" Margin="0,0,0,10">
        <StackPanel>
          <TextBlock Text="Captured definitions" FontWeight="SemiBold" AutomationProperties.AutomationId="PhysicalSymbols.DefinitionsHeading"/>
          <ListBox x:Name="SymDefinitionList" MinHeight="80" MaxHeight="180" Margin="0,6,0,0" SelectionChanged="DefinitionList_SelectionChanged" AutomationProperties.AutomationId="PhysicalSymbols.DefinitionList" AutomationProperties.Name="Physical symbol definitions">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Display}" TextWrapping="Wrap"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="SymDefinitionDetail" Style="{StaticResource SymCaption}" Margin="0,6,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="PhysicalSymbols.DefinitionDetail"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource SymCard}" Margin="0,0,0,10">
        <StackPanel>
          <TextBlock Text="Candidate operations" FontWeight="SemiBold" AutomationProperties.AutomationId="PhysicalSymbols.ActionsHeading"/>
          <ItemsControl x:Name="SymActionList" Margin="0,6,0,0" AutomationProperties.AutomationId="PhysicalSymbols.ActionList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,6">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Reason}" Style="{StaticResource SymCaption}" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding NextStep}" Style="{StaticResource SymCaption}" TextWrapping="Wrap"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource SymCard}" Margin="0,0,0,10">
        <StackPanel>
          <TextBlock Text="Engine binding (staged PACKAGE, activation, preview/apply, publication)" FontWeight="SemiBold" AutomationProperties.AutomationId="PhysicalSymbols.BindingHeading"/>
          <TextBlock x:Name="SymBindingState" Style="{StaticResource SymCaption}" Margin="0,6,0,6" TextWrapping="Wrap" AutomationProperties.AutomationId="PhysicalSymbols.BindingState"/>
          <TextBlock Text="Stage" Style="{StaticResource SymCaption}"/>
          <TextBox x:Name="SymStagingRootBox" Margin="0,2,0,4" AutomationProperties.AutomationId="PhysicalSymbols.StagingRoot" AutomationProperties.Name="Staging root (absolute path)"/>
          <TextBox x:Name="SymSymbolNameBox" Margin="0,0,0,4" AutomationProperties.AutomationId="PhysicalSymbols.SymbolName" AutomationProperties.Name="Staged symbol name"/>
          <Button x:Name="SymStageButton" Content="Stage PACKAGE work area" Click="StageButton_Click" Margin="0,0,0,6" AutomationProperties.AutomationId="PhysicalSymbols.StageButton" AutomationProperties.Name="Stage PACKAGE work area"/>
          <TextBlock Text="Activation descriptor (exact release-manifest identity)" Style="{StaticResource SymCaption}"/>
          <TextBox x:Name="SymExtVersionBox" Margin="0,2,0,4" AutomationProperties.AutomationId="PhysicalSymbols.ExtVersion" AutomationProperties.Name="Extension three-part version"/>
          <TextBox x:Name="SymExtEntryBox" Margin="0,0,0,4" AutomationProperties.AutomationId="PhysicalSymbols.ExtEntry" AutomationProperties.Name="Extension relative entry file"/>
          <TextBox x:Name="SymExtHashBox" Margin="0,0,0,4" AutomationProperties.AutomationId="PhysicalSymbols.ExtHash" AutomationProperties.Name="Extension lowercase SHA-256 content hash"/>
          <Button x:Name="SymActivateButton" Content="Activate binding" Click="ActivateButton_Click" Margin="0,0,0,6" AutomationProperties.AutomationId="PhysicalSymbols.ActivateButton" AutomationProperties.Name="Activate symbol binding"/>
          <TextBlock Text="Request (frozen intent JSON, staged document, readback)" Style="{StaticResource SymCaption}"/>
          <TextBox x:Name="SymOperationBox" Margin="0,2,0,4" AutomationProperties.AutomationId="PhysicalSymbols.Operation" AutomationProperties.Name="Operation (one of the 17 candidate operations)"/>
          <TextBox x:Name="SymTargetBox" Margin="0,0,0,4" AutomationProperties.AutomationId="PhysicalSymbols.Target" AutomationProperties.Name="Target identity"/>
          <TextBox x:Name="SymIntentBox" MinHeight="60" MaxHeight="140" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="0,0,0,4" AutomationProperties.AutomationId="PhysicalSymbols.IntentJson" AutomationProperties.Name="Frozen intent envelope JSON"/>
          <TextBox x:Name="SymContextFingerprintBox" Margin="0,0,0,4" AutomationProperties.AutomationId="PhysicalSymbols.ContextFingerprint" AutomationProperties.Name="Context fingerprint (lowercase SHA-256 of the capture the intent was authored against)"/>
          <TextBox x:Name="SymApprovalBox" Margin="0,0,0,4" AutomationProperties.AutomationId="PhysicalSymbols.Approval" AutomationProperties.Name="Bounded approval identity"/>
          <WrapPanel Margin="0,0,0,6">
            <Button x:Name="SymPrepareButton" Content="Preview" Click="PrepareButton_Click" Margin="0,0,8,4" AutomationProperties.AutomationId="PhysicalSymbols.PrepareButton" AutomationProperties.Name="Preview request (non-mutating)"/>
            <Button x:Name="SymApplyButton" Content="Apply" Click="ApplyButton_Click" Margin="0,0,8,4" AutomationProperties.AutomationId="PhysicalSymbols.ApplyButton" AutomationProperties.Name="Apply prepared request with readback"/>
          </WrapPanel>
          <TextBlock Text="DRA publication (completed apply only; PSM stays refused)" Style="{StaticResource SymCaption}"/>
          <TextBox x:Name="SymDestinationBox" Margin="0,2,0,4" AutomationProperties.AutomationId="PhysicalSymbols.Destination" AutomationProperties.Name="Library destination directory (absolute path)"/>
          <Button x:Name="SymPublishButton" Content="Publish DRA" Click="PublishButton_Click" Margin="0,0,0,6" AutomationProperties.AutomationId="PhysicalSymbols.PublishButton" AutomationProperties.Name="Publish staged DRA to library"/>
          <TextBlock x:Name="SymBindingResult" Style="{StaticResource SymCaption}" TextWrapping="Wrap" AutomationProperties.AutomationId="PhysicalSymbols.BindingResult"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource SymCard}">
        <StackPanel>
          <TextBlock Text="Vendor limits" FontWeight="SemiBold" AutomationProperties.AutomationId="PhysicalSymbols.LimitsHeading"/>
          <TextBlock x:Name="SymLimitsDetail" Style="{StaticResource SymCaption}" Margin="0,6,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="PhysicalSymbols.LimitsDetail"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

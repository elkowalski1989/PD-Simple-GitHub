<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PD.Simple.Tools.PhysicalSymbols" x:Class="PD.Simple.Tools.PhysicalSymbols.PhysicalSymbolsView" Background="#F5F8FD" Foreground="#17243B" FontSize="11">
  <UserControl.Resources>
    <SolidColorBrush x:Key="SymInk" Color="#17243B"/>
    <SolidColorBrush x:Key="SymMuted" Color="#59708E"/>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SymInk}"/>
    </Style>
    <Style x:Key="SymCaption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SymMuted}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SymCard" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#DCE7F5"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="12"/>
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16" Orientation="Vertical">
      <TextBlock Text="Physical symbols" FontSize="16" FontWeight="SemiBold" AutomationProperties.AutomationId="PhysicalSymbols.Title"/>
      <TextBlock x:Name="SymModeLine" Style="{StaticResource SymCaption}" Margin="0,2,0,10" AutomationProperties.AutomationId="PhysicalSymbols.Mode"/>
      <Border Style="{StaticResource SymCard}" Margin="0,0,0,10">
        <StackPanel>
          <TextBlock Text="Staged PACKAGE work area" FontWeight="SemiBold" AutomationProperties.AutomationId="PhysicalSymbols.StageHeading"/>
          <TextBlock x:Name="SymStageDetail" Style="{StaticResource SymCaption}" Margin="0,6,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="PhysicalSymbols.StageDetail"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource SymCard}" Margin="0,0,0,10">
        <StackPanel>
          <TextBlock Text="Captured definitions" FontWeight="SemiBold" AutomationProperties.AutomationId="PhysicalSymbols.DefinitionsHeading"/>
          <ListBox x:Name="SymDefinitionList" MinHeight="80" MaxHeight="180" Margin="0,6,0,0" SelectionChanged="DefinitionList_SelectionChanged" AutomationProperties.AutomationId="PhysicalSymbols.DefinitionList" AutomationProperties.Name="Physical symbol definitions"/>
          <TextBlock x:Name="SymDefinitionDetail" Style="{StaticResource SymCaption}" Margin="0,6,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="PhysicalSymbols.DefinitionDetail"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource SymCard}" Margin="0,0,0,10">
        <StackPanel>
          <TextBlock Text="Candidate operations" FontWeight="SemiBold" AutomationProperties.AutomationId="PhysicalSymbols.ActionsHeading"/>
          <ItemsControl x:Name="SymActionList" Margin="0,6,0,0" AutomationProperties.AutomationId="PhysicalSymbols.ActionList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,6">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Reason}" Style="{StaticResource SymCaption}" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding NextStep}" Style="{StaticResource SymCaption}" TextWrapping="Wrap"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource SymCard}">
        <StackPanel>
          <TextBlock Text="Vendor limits" FontWeight="SemiBold" AutomationProperties.AutomationId="PhysicalSymbols.LimitsHeading"/>
          <TextBlock x:Name="SymLimitsDetail" Style="{StaticResource SymCaption}" Margin="0,6,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="PhysicalSymbols.LimitsDetail"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

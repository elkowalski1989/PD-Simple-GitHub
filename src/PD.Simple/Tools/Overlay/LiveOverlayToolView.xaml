<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PD.Simple.Tools.Overlay.LiveOverlayToolView"
             Background="#F5F8FD">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28" MaxWidth="980">
      <TextBlock Text="Live overlay tools" FontSize="27" FontWeight="Bold"/>
      <TextBlock Text="Create display-only drawings over the live Allegro canvas: pick an anchor, choose an annotation, style it, and show it. Publishing returns a per-request receipt; local drawings never become native copper and gestures never edit Allegro."
                 Foreground="#59708E" Margin="0,8,0,0"/>

      <Border Background="#FFF7E8" BorderBrush="#EDD9A8" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,14,0,0">
        <TextBlock x:Name="OfflineNote" Foreground="#7A5B16"
                   Text="No live scene held. When Allegro is connected, Build preview or Use visible canvas center acquires it automatically; Refresh scene reacquires it. Nothing is built while offline."/>
      </Border>

      <!-- 1. Scene -->
      <TextBlock Text="1. Live scene" FontSize="17" FontWeight="SemiBold" Margin="0,20,0,8"/>
      <WrapPanel>
        <Button x:Name="AcquireButton" IsEnabled="False" Content="Refresh scene" Click="Acquire_Click"
                AutomationProperties.Name="Refresh live scene for overlay tools"/>
        <Button x:Name="ExplorerButton" Content="Pick anchor in Explorer (Inspect)" Click="Explorer_Click" Margin="8,0,0,0"
                AutomationProperties.Name="Open Board Explorer Inspect section for anchor picking"/>
        <Button x:Name="CancelButton" IsEnabled="False" Content="Cancel" Click="Cancel_Click" Margin="8,0,0,0"
                AutomationProperties.Name="Cancel overlay tool operation"/>
      </WrapPanel>

      <!-- 2. Anchor -->
      <TextBlock Text="2. Anchor" FontSize="17" FontWeight="SemiBold" Margin="0,20,0,8"/>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Board X (mils)" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox x:Name="AnchorXInput" Width="110" Padding="6" AutomationProperties.Name="Board anchor X in mils"/>
        <TextBlock Text="Y (mils)" VerticalAlignment="Center" Margin="12,0,8,0"/>
        <TextBox x:Name="AnchorYInput" Width="110" Padding="6" AutomationProperties.Name="Board anchor Y in mils"/>
        <CheckBox x:Name="ObjectAnchorCheck" Content="Anchor to a captured object" VerticalAlignment="Center" Margin="16,0,0,0"
                  AutomationProperties.Name="Anchor to a captured object"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <TextBlock Text="Object id" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox x:Name="ObjectIdInput" Width="300" Padding="6" AutomationProperties.Name="Captured object id for anchor"/>
        <TextBlock Text="Copy the id from Explorer Inspect, then build. The anchor resolves through the Engine frame resolver at build time."
                   Foreground="#59708E" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <Button x:Name="UseVisibleCenterButton" IsEnabled="False" Content="Use visible canvas center" Click="UseVisibleCenter_Click"
                AutomationProperties.Name="Use visible canvas center as board anchor"/>
        <TextBlock Text="Acquires the live scene when needed, then anchors at the visible center of the live canvas. The built preview is invalidated; rebuild before publishing."
                   Foreground="#59708E" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
      </StackPanel>

      <!-- 3. Annotation -->
      <TextBlock Text="3. Annotation" FontSize="17" FontWeight="SemiBold" Margin="0,20,0,8"/>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Shape" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="ShapePicker" Width="150" SelectionChanged="Shape_Changed" AutomationProperties.Name="Overlay shape"/>
        <TextBlock Text="Element id" VerticalAlignment="Center" Margin="16,0,8,0"/>
        <TextBox x:Name="ElementIdInput" Width="160" Padding="6" AutomationProperties.Name="Overlay element id"/>
      </StackPanel>

      <Grid x:Name="LinePanel" Margin="0,8,0,0">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="x1, y1, x2, y2 (mils)" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox x:Name="LineInput" Width="320" Padding="6" AutomationProperties.Name="Line endpoints in mils"/>
        </StackPanel>
      </Grid>
      <Grid x:Name="CirclePanel" Margin="0,8,0,0" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="center-x, center-y, radius (mils)" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox x:Name="CircleInput" Width="320" Padding="6" AutomationProperties.Name="Circle parameters in mils"/>
        </StackPanel>
      </Grid>
      <Grid x:Name="EllipsePanel" Margin="0,8,0,0" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="center-x, center-y, radius-x, radius-y (mils)" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox x:Name="EllipseInput" Width="320" Padding="6" AutomationProperties.Name="Ellipse parameters in mils"/>
        </StackPanel>
      </Grid>
      <Grid x:Name="RectPanel" Margin="0,8,0,0" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="x, y, width, height (mils)" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox x:Name="RectInput" Width="320" Padding="6" AutomationProperties.Name="Rectangle parameters in mils"/>
        </StackPanel>
      </Grid>
      <Grid x:Name="PolygonPanel" Margin="0,8,0,0" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="One x, y point per line (mils, at least 3)"/>
          <TextBox x:Name="PolygonInput" Width="320" Height="86" AcceptsReturn="True" Padding="6" Margin="0,4,0,0"
                   AutomationProperties.Name="Polygon points in mils"/>
        </StackPanel>
      </Grid>
      <Grid x:Name="PolylinePanel" Margin="0,8,0,0" Visibility="Collapsed">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="One x, y point per line (mils, at least 2)" VerticalAlignment="Center"/>
            <CheckBox x:Name="PolylineClosedCheck" Content="Closed" VerticalAlignment="Center" Margin="16,0,0,0"
                      AutomationProperties.Name="Close polyline path"/>
          </StackPanel>
          <TextBox x:Name="PolylineInput" Width="320" Height="86" AcceptsReturn="True" Padding="6" Margin="0,4,0,0"
                   AutomationProperties.Name="Polyline points in mils"/>
        </StackPanel>
      </Grid>
      <Grid x:Name="TextPanel" Margin="0,8,0,0" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Text" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox x:Name="OverlayTextInput" Width="280" Padding="6" AutomationProperties.Name="Overlay text content"/>
          <TextBlock Text="Size (px)" VerticalAlignment="Center" Margin="12,0,8,0"/>
          <TextBox x:Name="FontSizeInput" Width="70" Padding="6" AutomationProperties.Name="Overlay text size in pixels"/>
        </StackPanel>
      </Grid>
      <Grid x:Name="MarkerPanel" Margin="0,8,0,0" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Kind" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ComboBox x:Name="MarkerKindPicker" Width="130" AutomationProperties.Name="Marker kind"/>
          <TextBlock Text="Size (px)" VerticalAlignment="Center" Margin="12,0,8,0"/>
          <TextBox x:Name="MarkerSizeInput" Width="70" Padding="6" AutomationProperties.Name="Marker size in pixels"/>
        </StackPanel>
      </Grid>
      <Grid x:Name="DimensionPanel" Margin="0,8,0,0" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="x1, y1, x2, y2 (mils)" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox x:Name="DimensionInput" Width="280" Padding="6" AutomationProperties.Name="Dimension endpoints in mils"/>
          <TextBlock Text="Kind" VerticalAlignment="Center" Margin="12,0,8,0"/>
          <ComboBox x:Name="DimensionKindPicker" Width="120" AutomationProperties.Name="Dimension kind"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <TextBlock Text="Label (optional)" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox x:Name="DimensionLabelInput" Width="280" Padding="6" AutomationProperties.Name="Dimension label"/>
        </StackPanel>
      </Grid>

      <!-- 4. Style -->
      <TextBlock Text="4. Style" FontSize="17" FontWeight="SemiBold" Margin="0,20,0,8"/>
      <WrapPanel>
        <TextBlock Text="Stroke" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="StrokePicker" Width="110" AutomationProperties.Name="Stroke color"/>
        <TextBlock Text="Width (px)" VerticalAlignment="Center" Margin="12,0,8,0"/>
        <TextBox x:Name="StrokeWidthInput" Width="60" Padding="6" AutomationProperties.Name="Stroke width in pixels"/>
        <CheckBox x:Name="FillCheck" Content="Fill" VerticalAlignment="Center" Margin="16,0,8,0" AutomationProperties.Name="Fill shape"/>
        <ComboBox x:Name="FillPicker" Width="110" AutomationProperties.Name="Fill color"/>
        <TextBlock Text="Opacity" VerticalAlignment="Center" Margin="12,0,8,0"/>
        <TextBox x:Name="OpacityInput" Width="60" Padding="6" AutomationProperties.Name="Opacity zero to one"/>
        <TextBlock Text="Z-order" VerticalAlignment="Center" Margin="12,0,8,0"/>
        <TextBox x:Name="ZOrderInput" Width="70" Padding="6" AutomationProperties.Name="Z order"/>
      </WrapPanel>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <CheckBox x:Name="VisibleCheck" Content="Visible" VerticalAlignment="Center" IsChecked="True"
                  AutomationProperties.Name="Overlay group visible"/>
        <TextBlock Text="Hit-test" VerticalAlignment="Center" Margin="16,0,8,0"/>
        <ComboBox x:Name="HitTestPicker" Width="110" AutomationProperties.Name="Hit test policy"/>
        <TextBlock Text="Hit-test is advisory display metadata. Live gesture feedback surfaces in Board Explorer's canvas; this panel never edits native objects."
                   Foreground="#59708E" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
      </StackPanel>

      <!-- 5. Show -->
      <TextBlock Text="5. Show" FontSize="17" FontWeight="SemiBold" Margin="0,20,0,8"/>
      <WrapPanel>
        <Button x:Name="BuildButton" IsEnabled="False" Content="Build preview" Click="Build_Click"
                AutomationProperties.Name="Build overlay preview"/>
        <Button x:Name="PublishButton" IsEnabled="False" Content="Publish (show)" Click="Publish_Click" Margin="8,0,0,0"
                AutomationProperties.Name="Publish overlay to live view"/>
        <Button x:Name="HideButton" IsEnabled="False" Content="Hide scope" Click="Hide_Click" Margin="8,0,0,0"
                AutomationProperties.Name="Hide overlay tool scope"/>
        <Button x:Name="RemoveButton" IsEnabled="False" Content="Remove scope" Click="Remove_Click" Margin="8,0,0,0"
                AutomationProperties.Name="Remove overlay tool scope"/>
        <Button x:Name="RecipeButton" IsEnabled="False" Content="Copy C# recipe" Click="Recipe_Click" Margin="8,0,0,0"
                AutomationProperties.Name="Copy overlay C sharp recipe"/>
      </WrapPanel>
      <TextBlock x:Name="ValidationText" Foreground="#B23D35" Margin="0,8,0,0"/>

      <Border Background="White" BorderBrush="#DCE7F5" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock x:Name="StatusText" Text="This page opens offline; publishing needs Allegro." FontWeight="SemiBold"/>
          <TextBlock x:Name="PublicationText" Text="No publication yet." Foreground="#59708E" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>

      <TextBlock Text="Operations (per-request receipts)" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,8"/>
      <ListBox x:Name="OperationsList" MinHeight="80" MaxHeight="220" DisplayMemberPath="Evidence"
               AutomationProperties.Name="Overlay publication operations"/>
      <TextBlock Text="Removing clears only this tool's scope on its own revision chain and keeps the receipt as evidence. The shared presentation carries one overlay lease: publishing replaces visible lease pixels, and other tools republish their own overlays on next use."
                 Foreground="#59708E" FontSize="11" Margin="0,8,0,20"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>

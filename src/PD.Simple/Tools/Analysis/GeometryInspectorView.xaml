<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PD.Simple.Tools.Analysis.GeometryInspectorView"
             Background="#F5F8FD"
             AutomationProperties.Name="Geometry inspector task view">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" MaxWidth="980">
      <TextBlock Text="Geometry inspector" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="Typed inspection over an explicitly attached capture. Search and selection are local; contour detail loads explicitly."
                 Foreground="#59708E" Margin="0,6,0,0"/>
      <TextBlock Text="{Binding SourceProvenance}" Foreground="#59708E" FontSize="11" Margin="0,4,0,0"/>
      <TextBlock Text="{Binding CoverageSummary}" Margin="0,8,0,0"/>
      <TextBlock Text="{Binding FamilyCoverageSummary}" Foreground="#59708E" Margin="0,2,0,0"/>
      <TextBlock Text="{Binding StackupSummary}" Foreground="#59708E" Margin="0,2,0,0"/>

      <TextBlock Text="Search" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,8"/>
      <StackPanel Orientation="Horizontal">
        <ComboBox x:Name="FamilyBox" Width="170" Height="30" AutomationProperties.Name="Object family"/>
        <TextBox x:Name="SearchInput" Width="260" Height="30" Padding="8,0" VerticalContentAlignment="Center" Margin="8,0,0,0"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search text"/>
        <TextBox x:Name="MaxRowsInput" Width="90" Height="30" Padding="8,0" VerticalContentAlignment="Center" Margin="8,0,0,0"
                 Text="{Binding MaximumSearchRows, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Maximum search rows"/>
        <Button x:Name="SearchButton" Content="Search" Click="Search_Click" Margin="8,0,0,0" Background="#147CF8" Foreground="White"
                AutomationProperties.Name="Search objects"/>
      </StackPanel>
      <ListBox x:Name="HitsList" Height="150" Margin="0,8,0,0" ItemsSource="{Binding Hits}" SelectionChanged="Hits_SelectionChanged"
               AutomationProperties.Name="Object search results">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Family}" Foreground="#59708E" Margin="0,0,8,0"/>
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Text="Inspection" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,8"/>
      <TextBlock Text="{Binding InspectionText}"/>
      <TextBlock Text="{Binding DetailBlockedReason}" Foreground="#8A5A00" Margin="0,6,0,0"/>
      <WrapPanel Margin="0,8,0,0">
        <Button x:Name="LoadDetailsButton" Content="Load detailed geometry" Click="LoadDetails_Click"
                AutomationProperties.Name="Load detailed geometry"/>
        <Button x:Name="MeasureAButton" Content="Set as measure A" Click="MeasureA_Click" AutomationProperties.Name="Set measure endpoint A"/>
        <Button x:Name="MeasureBButton" Content="Set as measure B" Click="MeasureB_Click" AutomationProperties.Name="Set measure endpoint B"/>
        <Button x:Name="MeasureButton" Content="Measure selected pair" Click="Measure_Click" AutomationProperties.Name="Measure selected pair"/>
      </WrapPanel>
      <TextBlock Text="{Binding MeasureSummary}" Margin="0,6,0,0"/>
      <TextBlock Text="{Binding HighlightRequestText}" Foreground="#59708E" Margin="0,4,0,0"/>

      <Expander Header="Advanced: copper detail, vertices, recipe, export" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="{Binding CopperDetailText}" Margin="0,8,0,0"/>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <TextBox x:Name="VertexPageInput" Width="80" Height="28" Padding="8,0" VerticalContentAlignment="Center" Text="0"
                     AutomationProperties.Name="Vertex page index"/>
            <Button x:Name="SampleButton" Content="Sample vertices page" Click="Sample_Click" Margin="8,0,0,0"
                    AutomationProperties.Name="Sample vertices page"/>
          </StackPanel>
          <TextBlock Text="{Binding VertexPageInfo}" Margin="0,4,0,0"/>
          <ListBox ItemsSource="{Binding VertexPage}" Height="90" Margin="0,4,0,0" AutomationProperties.Name="Sampled vertices"/>
          <CheckBox x:Name="RecipeDetailsBox" Content="Include details in recipe" IsChecked="{Binding RecipeDetails}" Margin="0,10,0,0"
                    AutomationProperties.Name="Include details in recipe" VerticalContentAlignment="Center"/>
          <TextBlock Text="{Binding RecipeText}" Margin="0,4,0,0"/>
          <WrapPanel Margin="0,4,0,0">
            <Button x:Name="CopyRecipeButton" Content="Copy recipe" Click="CopyRecipe_Click" AutomationProperties.Name="Copy inspection recipe"/>
          </WrapPanel>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <TextBox x:Name="ExportPathInput" Width="320" Height="30" Padding="8,0" VerticalContentAlignment="Center"
                     AutomationProperties.Name="Inspector facts path"/>
            <CheckBox x:Name="ExportOverwriteBox" Content="Overwrite" Margin="10,0,0,0" VerticalContentAlignment="Center"
                      AutomationProperties.Name="Overwrite inspector facts"/>
            <Button x:Name="ExportButton" Content="Export facts" Click="Export_Click" Margin="10,0,0,0"
                    AutomationProperties.Name="Export inspector facts"/>
          </StackPanel>
        </StackPanel>
      </Expander>

      <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" Margin="0,16,0,0"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>

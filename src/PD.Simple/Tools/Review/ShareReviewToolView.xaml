<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PD.Simple.Tools.Review.ShareReviewToolView"
             Background="#F5F8FD">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28" MaxWidth="980">
      <TextBlock Text="Share / review view" FontSize="27" FontWeight="Bold"/>
      <TextBlock Text="Capture the current qualified view with review annotations, compare raw and annotated output, save PNGs, export evidence bundles, and reopen bundles offline. Captures run only when you choose Capture; review work never drives fast Browse and no diagnostic images are produced by default."
                 Foreground="#59708E" Margin="0,8,0,0"/>

      <!-- 1. Scene -->
      <TextBlock Text="1. Live scene" FontSize="17" FontWeight="SemiBold" Margin="0,20,0,8"/>
      <WrapPanel>
        <Button x:Name="AcquireButton" IsEnabled="False" Content="Acquire live scene" Click="Acquire_Click"
                AutomationProperties.Name="Acquire live scene for review"/>
        <Button x:Name="CaptureButton" IsEnabled="False" Content="Capture review" Click="Capture_Click" Margin="8,0,0,0"
                AutomationProperties.Name="Capture review frame"/>
        <Button x:Name="CancelButton" IsEnabled="False" Content="Cancel" Click="Cancel_Click" Margin="8,0,0,0"
                AutomationProperties.Name="Cancel review operation"/>
      </WrapPanel>

      <!-- 2. Annotations -->
      <TextBlock Text="2. Review annotations" FontSize="17" FontWeight="SemiBold" Margin="0,20,0,8"/>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Title stamp" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox x:Name="TitleInput" Width="280" Padding="6" AutomationProperties.Name="Review title stamp"/>
        <TextBlock Text="at X, Y (mils)" VerticalAlignment="Center" Margin="12,0,8,0"/>
        <TextBox x:Name="StampXInput" Width="90" Padding="6" AutomationProperties.Name="Review stamp X in mils"/>
        <TextBox x:Name="StampYInput" Width="90" Padding="6" Margin="6,0,0,0" AutomationProperties.Name="Review stamp Y in mils"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <CheckBox x:Name="LinkObjectCheck" Content="Link an object marker" VerticalAlignment="Center"
                  AutomationProperties.Name="Link review marker to captured object"/>
        <TextBox x:Name="ObjectIdInput" Width="260" Padding="6" Margin="12,0,0,0" AutomationProperties.Name="Review marker object id"/>
        <TextBlock Text="Object ids come from Explorer Inspect. A marker on an absent object blocks capture with a reason."
                   Foreground="#59708E" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
      </StackPanel>

      <!-- 3. View -->
      <TextBlock Text="3. View" FontSize="17" FontWeight="SemiBold" Margin="0,20,0,8"/>
      <StackPanel Orientation="Horizontal">
        <RadioButton x:Name="AnnotatedRadio" Content="Annotated" IsChecked="True" VerticalAlignment="Center"
                     Checked="Display_Changed" AutomationProperties.Name="Show annotated review image"/>
        <RadioButton x:Name="RawRadio" Content="Raw" VerticalAlignment="Center" Margin="16,0,0,0"
                     Checked="Display_Changed" AutomationProperties.Name="Show raw review image"/>
        <TextBlock Text="A static exported PNG is not a recording-compatibility promise; sharing modes stay labeled, not guaranteed."
                   Foreground="#59708E" FontSize="11" VerticalAlignment="Center" Margin="16,0,0,0"/>
      </StackPanel>
      <Border BorderBrush="#DCE7F5" BorderThickness="1" CornerRadius="6" Background="White" Margin="0,8,0,0">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="420">
          <Image x:Name="ReviewImage" Stretch="None" AutomationProperties.Name="Review image"/>
        </ScrollViewer>
      </Border>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <Slider x:Name="ZoomSlider" Width="200" Minimum="0.25" Maximum="4" Value="1" TickFrequency="0.25"
                IsSnapToTickEnabled="True" ValueChanged="Zoom_Changed" AutomationProperties.Name="Review image zoom"/>
        <TextBlock x:Name="ZoomText" Text="100%" VerticalAlignment="Center" Margin="8,0,0,0"/>
        <TextBlock x:Name="EvidenceText" Foreground="#59708E" FontSize="11" VerticalAlignment="Center" Margin="16,0,0,0"/>
      </StackPanel>

      <!-- 4. Output -->
      <TextBlock Text="4. Output" FontSize="17" FontWeight="SemiBold" Margin="0,20,0,8"/>
      <WrapPanel>
        <Button x:Name="SaveRawButton" IsEnabled="False" Content="Save raw PNG…" Click="SaveRaw_Click"
                AutomationProperties.Name="Save raw review PNG"/>
        <Button x:Name="SaveAnnotatedButton" IsEnabled="False" Content="Save annotated PNG…" Click="SaveAnnotated_Click" Margin="8,0,0,0"
                AutomationProperties.Name="Save annotated review PNG"/>
        <Button x:Name="CopyPathButton" Content="Copy output path" Click="CopyPath_Click" Margin="8,0,0,0"
                AutomationProperties.Name="Copy review output path"/>
      </WrapPanel>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <TextBlock Text="Bundle directory" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox x:Name="OutputDirInput" Width="340" Padding="6" AutomationProperties.Name="Review bundle directory"/>
        <Button x:Name="BrowseDirButton" Content="Browse…" Click="BrowseDir_Click" Margin="8,0,0,0"
                AutomationProperties.Name="Browse for review bundle directory"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <TextBlock Text="Bundle note" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox x:Name="BundleNoteInput" Width="340" Padding="6" AutomationProperties.Name="Review bundle note"/>
        <Button x:Name="ExportBundleButton" IsEnabled="False" Content="Export bundle" Click="ExportBundle_Click" Margin="8,0,0,0"
                AutomationProperties.Name="Export review bundle"/>
      </StackPanel>

      <!-- 5. Reopen -->
      <TextBlock Text="5. Reopen offline" FontSize="17" FontWeight="SemiBold" Margin="0,20,0,8"/>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="ReopenButton" Content="Reopen bundle…" Click="Reopen_Click"
                AutomationProperties.Name="Reopen review bundle offline"/>
        <Button x:Name="PruneButton" Content="Prune orphans in bundle dir" Click="Prune_Click" Margin="8,0,0,0"
                AutomationProperties.Name="Prune orphan files in bundle directory"/>
      </StackPanel>
      <TextBlock Text="Retained bundles" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,8"/>
      <ListBox x:Name="RetainedList" MinHeight="60" MaxHeight="160" DisplayMemberPath="Evidence"
               AutomationProperties.Name="Retained review bundles"/>
      <Button x:Name="RemoveButton" Content="Remove selected bundle" Click="Remove_Click" HorizontalAlignment="Left" Margin="0,8,0,0"
              AutomationProperties.Name="Remove selected review bundle"/>
      <TextBlock x:Name="RetentionText" Foreground="#59708E" Margin="0,8,0,0"/>

      <Border Background="White" BorderBrush="#DCE7F5" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,14,0,20">
        <TextBlock x:Name="StatusText" Text="Acquire a live scene to capture, or reopen a saved bundle offline." FontWeight="SemiBold"/>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

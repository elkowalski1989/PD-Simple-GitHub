<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:corridor="clr-namespace:PD.Simple.Corridor"
        xmlns:engine="clr-namespace:PD.Simple.Engine"
        xmlns:largeBoards="clr-namespace:PD.Simple.LargeBoards"
        xmlns:padstacks="clr-namespace:PD.Simple.Tools.Padstacks"
        xmlns:mfg="clr-namespace:PD.Simple.Manufacturing"
        xmlns:constraintsDrc="clr-namespace:PD.Simple.Tools.ConstraintsDrc"
        xmlns:physym="clr-namespace:PD.Simple.Tools.PhysicalSymbols"
        xmlns:overlay="clr-namespace:PD.Simple.Tools.Overlay"
        xmlns:review="clr-namespace:PD.Simple.Tools.Review"
        xmlns:engineWorkspace="clr-namespace:PD.Simple.Tools.EngineWorkspace"
        x:Class="PD.Simple.MainWindow"
        Title="PD Simple — Allegro Engine Showcase"
        Width="1480" Height="920" MinWidth="1120" MinHeight="720"
        Background="#F4F8FC" Foreground="#17243B" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#17243B"/>
      <Setter Property="BorderBrush" Value="#C9D8ED"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="78"/>
      <Setter Property="Height" Value="68"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Padding" Value="4,8"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="#10243A"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="3,0,0,0"/>
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="NavChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="NavChrome" Property="Background" Value="#173653"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="NavChrome" Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NavIcon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="Foreground" Value="#E8F3FF"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="FutureNavButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
      <Setter Property="IsEnabled" Value="False"/>
      <Setter Property="Opacity" Value="0.55"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Window.Resources>

  <Grid x:Name="ShellGrid">
    <Grid.RowDefinitions>
      <RowDefinition x:Name="HeaderRow" Height="56"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border x:Name="HeaderBar" Background="White" BorderBrush="#DCE7F5" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="164"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#0D2135" Padding="14,8">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="34" Height="34" CornerRadius="7" Background="White" Margin="0,0,9,0">
              <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#147CF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="PD Simple" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <DockPanel Grid.Column="1" Margin="18,0,14,0">
          <Button DockPanel.Dock="Right" x:Name="ReconnectButton" Content="&#xE72C;" Width="36" Height="30" Padding="0" Margin="8,0,0,0" Click="Reconnect_Click"
                  FontFamily="Segoe MDL2 Assets" ToolTip="Reconnect or attach to an open Allegro board" AutomationProperties.Name="Reconnect or attach"/>
          <Button DockPanel.Dock="Right" x:Name="ScreenshotButton" Width="36" Height="30" Padding="0" Margin="8,0,0,0"
                  Click="Screenshot_Click" ToolTip="Save a PNG of the PD Simple window and copy it to the clipboard"
                  AutomationProperties.Name="Capture PD Simple window screenshot and copy path">
            <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
          </Button>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,4,0">
            <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#8A9BB0" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock x:Name="ConnectionText" Text="Not connected" Foreground="#31465C" FontSize="10" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                      VerticalAlignment="Center" Margin="10,0,0,0">
            <TextBlock Text="Capture product" Foreground="#31465C" FontSize="10"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="BackgroundCaptureProductInput" Width="150" Height="28"
                     VerticalContentAlignment="Center" MaxLength="128"
                     LostFocus="BackgroundCaptureProductInput_LostFocus"
                     ToolTip="Allegro -product token for the isolated read-only capture worker. This does not change the current board tier."
                     AutomationProperties.AutomationId="BackgroundCaptureProductInput"
                     AutomationProperties.Name="Background capture product"/>
          </StackPanel>
          <ToggleButton DockPanel.Dock="Right" x:Name="EmbeddedBoardDocumentToggle"
                        MinWidth="142" Height="30" Margin="10,0,0,0" Padding="10,0"
                        Content="Embedded drawing: Off"
                        Checked="EmbeddedBoardDocumentMode_Changed"
                        Unchecked="EmbeddedBoardDocumentMode_Changed"
                        ToolTip="Use the shared Engine drawing as the primary PD Simple board document. This setting does not capture board data."
                        AutomationProperties.AutomationId="EmbeddedBoardDocumentToggle"
                        AutomationProperties.Name="Enable embedded Engine board document"/>
          <Button DockPanel.Dock="Right" x:Name="NativeDockToggleButton"
                  MinWidth="110" Height="30" Margin="10,0,0,0" Padding="10,0"
                  Content="Dock Allegro"
                  Click="NativeDockToggle_Click"
                  ToolTip="Dock the connected Allegro editor beside PD Simple tools"
                  AutomationProperties.AutomationId="NativeDockToggleButton"
                  AutomationProperties.Name="Dock or undock Allegro editor"/>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="BreadcrumbText" Text="Home" Foreground="#45627F" FontSize="10" VerticalAlignment="Center"/>
            <Border Width="1" Height="28" Background="#DCE7F5" Margin="18,0"/>
            <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" Foreground="#147CF8" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="BoardText" Text="No board" Foreground="#31465C" FontSize="10" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="330" VerticalAlignment="Center"/>
          </StackPanel>
        </DockPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarColumn" Width="78"/>
        <ColumnDefinition x:Name="ContentColumn" Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Background="#10243A">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <Button x:Name="HomeMenuButton" Style="{StaticResource NavButton}" Click="Home_Click"
                    AutomationProperties.Name="Open Home">
              <StackPanel><TextBlock Text="&#xE80F;" Style="{StaticResource NavIcon}"/><TextBlock Text="Home" HorizontalAlignment="Center"/></StackPanel>
            </Button>
            <Button x:Name="ExplorerMenuButton" Style="{StaticResource NavButton}" Click="Explorer_Click" Visibility="Collapsed"
                    AutomationProperties.Name="Open Board Explorer">
              <StackPanel><TextBlock Text="&#x25A6;" Style="{StaticResource NavIcon}"/><TextBlock Text="Board Explorer"/><TextBlock Text="ENGINE" FontSize="9" Foreground="#6FD6A8"/></StackPanel>
            </Button>
            <Button x:Name="CorridorMenuButton" Style="{StaticResource NavButton}" Click="Corridor_Click"
                    AutomationProperties.Name="Open DP via corridor">
              <StackPanel><TextBlock Text="&#xE950;" Style="{StaticResource NavIcon}"/><TextBlock Text="DP" HorizontalAlignment="Center"/></StackPanel>
            </Button>
            <Button x:Name="CrossingMenuButton" Style="{StaticResource NavButton}" Click="Crossing_Click"
                    AutomationProperties.Name="Open Crossing review">
              <StackPanel><TextBlock Text="&#xE8A0;" Style="{StaticResource NavIcon}"/><TextBlock Text="Crossings" HorizontalAlignment="Center"/></StackPanel>
            </Button>
            <Button x:Name="InspectorMenuButton" Style="{StaticResource NavButton}" Click="Inspector_Click"
                    AutomationProperties.Name="Open Geometry inspector">
              <StackPanel><TextBlock Text="&#xE943;" Style="{StaticResource NavIcon}"/><TextBlock Text="Geometry" HorizontalAlignment="Center"/></StackPanel>
            </Button>
            <Button x:Name="RouteMenuButton" Style="{StaticResource NavButton}" Click="Route_Click" Visibility="Collapsed"
                    AutomationProperties.Name="Open Point-to-point trace">
              <StackPanel><TextBlock Text="&#x2794;" Style="{StaticResource NavIcon}"/><TextBlock Text="Point-to-point trace"/><TextBlock Text="LIVE" FontSize="9" Foreground="#6FD6A8"/></StackPanel>
            </Button>
            <Button x:Name="MeasureMenuButton" Style="{StaticResource NavButton}" Click="Measure_Click" Visibility="Collapsed"
                    AutomationProperties.Name="Open Pick measure ruler">
              <StackPanel><TextBlock Text="&#x2194;" Style="{StaticResource NavIcon}"/><TextBlock Text="Pick / measure / ruler"/><TextBlock Text="ENGINE" FontSize="9" Foreground="#6FD6A8"/></StackPanel>
            </Button>
            <Button x:Name="PlacementMenuButton" Style="{StaticResource NavButton}" Click="Placement_Click" Visibility="Collapsed"
                    AutomationProperties.Name="Open Placement handles">
              <StackPanel><TextBlock Text="&#x25C8;" Style="{StaticResource NavIcon}"/><TextBlock Text="Placement handles"/><TextBlock Text="ENGINE" FontSize="9" Foreground="#6FD6A8"/></StackPanel>
            </Button>
            <Button x:Name="ViaRouteMenuButton" Style="{StaticResource NavButton}" Click="ViaRoute_Click" Visibility="Collapsed"
                    AutomationProperties.Name="Open Via / route editing">
              <StackPanel><TextBlock Text="&#x254B;" Style="{StaticResource NavIcon}"/><TextBlock Text="Via / route editing"/><TextBlock Text="ENGINE" FontSize="9" Foreground="#6FD6A8"/></StackPanel>
            </Button>
            <Button x:Name="RoutePreviewMenuButton" Style="{StaticResource NavButton}" Click="RoutePreview_Click" Visibility="Collapsed"
                    AutomationProperties.Name="Open Route preview">
              <StackPanel><TextBlock Text="&#x27A4;" Style="{StaticResource NavIcon}"/><TextBlock Text="Route preview"/><TextBlock Text="ENGINE" FontSize="9" Foreground="#6FD6A8"/></StackPanel>
            </Button>
            <Button x:Name="OverlayMenuButton" Style="{StaticResource NavButton}" Click="Overlay_Click" Visibility="Collapsed"
                    AutomationProperties.Name="Open Live overlay tools">
              <StackPanel><TextBlock Text="&#x25E7;" Style="{StaticResource NavIcon}"/><TextBlock Text="Live overlay tools"/><TextBlock Text="LIVE" FontSize="9" Foreground="#6FD6A8"/></StackPanel>
            </Button>
            <Button x:Name="EngineReviewMenuButton" Style="{StaticResource NavButton}" Click="EngineReview_Click" Visibility="Collapsed"
                    AutomationProperties.Name="Open Review capture">
              <StackPanel><TextBlock Text="&#x229E;" Style="{StaticResource NavIcon}"/><TextBlock Text="Review capture"/><TextBlock Text="ENGINE" FontSize="9" Foreground="#6FD6A8"/></StackPanel>
            </Button>
            <Button x:Name="ScenesMenuButton" Style="{StaticResource NavButton}" Click="Scenes_Click" Visibility="Collapsed"
                    AutomationProperties.Name="Open Captured scenes">
              <StackPanel><TextBlock Text="&#x2750;" Style="{StaticResource NavIcon}"/><TextBlock Text="Captured scenes"/><TextBlock Text="ENGINE" FontSize="9" Foreground="#6FD6A8"/></StackPanel>
            </Button>
            <Button x:Name="ConstraintsDrcMenuButton" Style="{StaticResource NavButton}" Click="ConstraintsDrc_Click" Visibility="Collapsed"
                    AutomationProperties.Name="Open Constraints DRC">
              <StackPanel><TextBlock Text="&#x26A0;" Style="{StaticResource NavIcon}"/><TextBlock Text="Constraints / DRC"/></StackPanel>
            </Button>
            <Button x:Name="PhysicalSymbolsMenuButton" Style="{StaticResource NavButton}" Click="PhysicalSymbols_Click" Visibility="Collapsed"
                    AutomationProperties.Name="Open Physical symbols">
              <StackPanel><TextBlock Text="&#x03A9;" Style="{StaticResource NavIcon}"/><TextBlock Text="Physical symbols"/></StackPanel>
            </Button>
            <Button x:Name="PadstacksMenuButton" Style="{StaticResource NavButton}" Click="Padstacks_Click" Visibility="Collapsed"
                    AutomationProperties.Name="Open Padstacks">
              <StackPanel><TextBlock Text="&#x2295;" Style="{StaticResource NavIcon}"/><TextBlock Text="Padstacks"/></StackPanel>
            </Button>
            <Button x:Name="ManufacturingMenuButton" Style="{StaticResource NavButton}" Click="Manufacturing_Click" Visibility="Collapsed"
                    AutomationProperties.Name="Open Manufacturing">
              <StackPanel><TextBlock Text="&#x2699;" Style="{StaticResource NavIcon}"/><TextBlock Text="Manufacturing"/></StackPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1">
          <Button x:Name="ToolsMenuButton" Style="{StaticResource NavButton}" Click="Tools_Click" AutomationProperties.Name="Open tools menu">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Board Explorer" Click="Explorer_Click"/>
                <MenuItem Header="Point-to-point trace" Click="Route_Click"/>
                <MenuItem Header="Pick / measure / ruler" Click="Measure_Click"/>
                <MenuItem Header="Placement handles" Click="Placement_Click"/>
                <MenuItem Header="Via / route editing" Click="ViaRoute_Click"/>
                <MenuItem Header="Route preview" Click="RoutePreview_Click"/>
                <Separator/>
                <MenuItem Header="Live overlay tools" Click="Overlay_Click"/>
                <MenuItem Header="Review capture" Click="EngineReview_Click"/>
                <MenuItem Header="Captured scenes" Click="Scenes_Click"/>
                <MenuItem Header="Large-board capture" Click="LargeBoardCapture_Click"/>
                <Separator/>
                <MenuItem Header="Constraints / DRC" Click="ConstraintsDrc_Click"/>
                <MenuItem Header="Physical symbols" Click="PhysicalSymbols_Click"/>
                <MenuItem Header="Padstacks" Click="Padstacks_Click"/>
                <MenuItem Header="Manufacturing" Click="Manufacturing_Click"/>
                <MenuItem Header="Engine workspace (preview)" Click="EngineWorkspace_Click"/>
              </ContextMenu>
            </Button.ContextMenu>
            <StackPanel><TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}"/><TextBlock Text="Tools" HorizontalAlignment="Center"/></StackPanel>
          </Button>
          <Button x:Name="ReviewMenuButton" Style="{StaticResource NavButton}" Click="Review_Click" AutomationProperties.Name="Open Share review view">
            <StackPanel><TextBlock Text="&#xE9D2;" Style="{StaticResource NavIcon}"/><TextBlock Text="Review" HorizontalAlignment="Center"/></StackPanel>
          </Button>
        </StackPanel>
        <Button Grid.Row="2" x:Name="WindowCompactButton" Style="{StaticResource NavButton}"
                ContentTemplate="{x:Null}" Click="WindowCompact_Click" ToolTip="Collapse PD Simple to the navigation menu"
                AutomationProperties.AutomationId="WindowCompactButton" AutomationProperties.Name="Collapse window to navigation menu">
          <StackPanel><TextBlock x:Name="WindowCompactGlyph" Text="&#xAB;" FontSize="20" HorizontalAlignment="Center"/><TextBlock x:Name="WindowCompactLabel" Text="Collapse" HorizontalAlignment="Center"/></StackPanel>
        </Button>
        </Grid>
      </Border>

      <Grid Grid.Column="1" x:Name="ContentRoot">
        <ScrollViewer x:Name="HomePanel" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="34" MaxWidth="920">
            <TextBlock Text="Allegro Engine showcase" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock Text="One C# application surface for exploring board data, running engineering analysis, interacting with Allegro, applying guarded edits, reviewing overlays, and opening captured scenes. The small standalone samples remain the learning path; PD Simple is the full reference host."
                       Foreground="#59708E" FontSize="14" Margin="0,0,0,24"/>

            <Border Background="#EAF4FF" BorderBrush="#C7DFFB" BorderThickness="1" CornerRadius="7" Padding="16" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="Architecture migration in progress" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Text="The target application API is AllegroBridge.Engine. Existing proven native operations stay available while their orchestration moves upward from PD Simple into Engine. Disabled capabilities below are visible intentionally; they do not claim native support before the matching Engine package and qualification exist."
                           Foreground="#45627F" Margin="0,5,0,0"/>
              </StackPanel>
            </Border>

            <TextBlock Text="Available now" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <UniformGrid Columns="3" Margin="0,0,0,24">
              <Button Click="Explorer_Click" Padding="18" HorizontalContentAlignment="Left" Margin="0,0,10,0">
                <StackPanel>
                  <TextBlock Text="Board Explorer" FontSize="17"/>
                  <TextBlock Text="Acquire typed Engine scenes, browse relationships, navigate semantic objects, and open/save offline captures." FontWeight="Normal" Foreground="#59708E" Margin="0,7,0,0"/>
                </StackPanel>
              </Button>
              <Button Click="Corridor_Click" Padding="18" HorizontalContentAlignment="Left" Margin="0,0,10,0">
                <StackPanel>
                  <TextBlock Text="DP via corridor" FontSize="17"/>
                  <TextBlock Text="Screen captured board data, review findings, navigate the verified native board, and export review evidence." FontWeight="Normal" Foreground="#59708E" Margin="0,7,0,0"/>
                </StackPanel>
              </Button>
              <Button Click="Route_Click" Padding="18" HorizontalContentAlignment="Left" Margin="0">
                <StackPanel>
                  <TextBlock Text="Point-to-point trace" FontSize="17"/>
                  <TextBlock Text="Pick actual endpoints, create one H-first trace, admit native readback, and retain edit-specific Undo/recovery." FontWeight="Normal" Foreground="#59708E" Margin="0,7,0,0"/>
                </StackPanel>
              </Button>
            </UniformGrid>

            <TextBlock Text="Engine capability map" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <UniformGrid Columns="3">
              <Border Background="White" BorderBrush="#DCE7F5" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,10,10">
                <StackPanel><TextBlock Text="Explore" FontWeight="SemiBold"/><TextBlock Text="Components · nets · pins · pairs · layers · route graph" Foreground="#59708E" Margin="0,4,0,0"/></StackPanel>
              </Border>
              <Border Background="White" BorderBrush="#DCE7F5" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,10,10">
                <StackPanel><TextBlock Text="Analyze" FontWeight="SemiBold"/><TextBlock Text="Crossings · geometry · measurements · findings" Foreground="#59708E" Margin="0,4,0,0"/></StackPanel>
              </Border>
              <Border Background="White" BorderBrush="#DCE7F5" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                <StackPanel><TextBlock Text="Interact" FontWeight="SemiBold"/><TextBlock Text="Picking · markers · rulers · snapping · draggable handles" Foreground="#59708E" Margin="0,4,0,0"/></StackPanel>
              </Border>
              <Border Background="White" BorderBrush="#DCE7F5" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,10,10">
                <StackPanel><TextBlock Text="Edit" FontWeight="SemiBold"/><TextBlock Text="Trace · placement · alignment · vias · recovery" Foreground="#59708E" Margin="0,4,0,0"/></StackPanel>
              </Border>
              <Border Background="White" BorderBrush="#DCE7F5" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,10,10">
                <StackPanel><TextBlock Text="Review" FontWeight="SemiBold"/><TextBlock Text="Overlay · annotations · composed share/export view" Foreground="#59708E" Margin="0,4,0,0"/></StackPanel>
              </Border>
              <Border Background="White" BorderBrush="#DCE7F5" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                <StackPanel><TextBlock Text="Offline" FontWeight="SemiBold"/><TextBlock Text="Capture scene · reopen · analyze without live edit authority" Foreground="#59708E" Margin="0,4,0,0"/></StackPanel>
              </Border>
            </UniformGrid>

            <TextBlock Text="All twelve tool entries are wired: analysis and edit entries route to the shared Engine Workbench; live actions keep the Workbench's capability, license, approval, and recovery gates."
                       Foreground="#59708E" FontSize="12" Margin="0,8,0,0"/>
          </StackPanel>
        </ScrollViewer>

        <engine:EngineExplorerView x:Name="ExplorerView" Visibility="Collapsed"/>
        <largeBoards:LargeBoardCaptureView x:Name="LargeBoardCaptureView" Visibility="Collapsed"/>
        <corridor:DpViaCorridorView x:Name="CorridorView" Visibility="Collapsed"/>
        <padstacks:PadstacksView x:Name="PadstacksView" Visibility="Collapsed"/>
        <overlay:LiveOverlayToolView x:Name="OverlayView" Visibility="Collapsed"/>
        <review:ShareReviewToolView x:Name="ReviewView" Visibility="Collapsed"/>
        <mfg:ManufacturingView x:Name="ManufacturingView" Visibility="Collapsed"/>
        <constraintsDrc:ConstraintsDrcView x:Name="ConstraintsDrcView" Visibility="Collapsed"/>
        <physym:PhysicalSymbolsView x:Name="PhysicalSymbolsView" Visibility="Collapsed"/>
        <engineWorkspace:EngineWorkspacePage x:Name="EngineWorkspacePage" Visibility="Collapsed"/>

        <Grid x:Name="RoutePanel" Visibility="Collapsed" Margin="28">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Point-to-point trace" FontSize="27" FontWeight="Bold"/>
            <TextBlock Text="Create one H-first route between two actual Allegro picks. Native result admission and edit-specific recovery remain explicit while this workflow migrates into the Engine live workspace." Foreground="#59708E" Margin="0,8,0,0"/>
          </StackPanel>
          <Border Grid.Row="2" Background="White" BorderBrush="#DCE7F5" BorderThickness="1" CornerRadius="7" Padding="24" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="1. Choose trace width" FontSize="17" FontWeight="SemiBold"/>
              <StackPanel Orientation="Horizontal" Margin="0,12,0,6">
                <TextBox x:Name="WidthInput" Text="5" Width="120" Height="34" Padding="8,0" VerticalContentAlignment="Center" TextChanged="Width_Changed"/>
                <TextBlock Text="mil" Margin="10,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock x:Name="WidthError" Foreground="#B23D35" FontSize="11"/>
              <TextBlock Text="2. Pick the start, then the end in Allegro" FontSize="17" FontWeight="SemiBold" Margin="0,26,0,8"/>
              <TextBlock Text="The cursor ring shows native hit-test feedback. A blue marker holds the first pick. The route uses the clicked positions—not automatically the objects' centers." Foreground="#59708E"/>
              <WrapPanel Margin="0,18,0,0">
                <Button x:Name="StartRouteButton" Content="Select two objects" Click="StartRoute_Click" Background="#147CF8" Foreground="White"/>
                <Button x:Name="ClearPickButton" Content="Clear first pick" Click="ClearPick_Click"/>
                <Button x:Name="CancelRouteButton" Content="Cancel" Click="CancelRoute_Click"/>
              </WrapPanel>
              <Border Background="#EDF5FF" Padding="14" Margin="0,20,0,20" CornerRadius="5">
                <StackPanel>
                  <TextBlock x:Name="RoutePhaseText" Text="Ready when Allegro is connected" FontWeight="SemiBold"/>
                  <TextBlock x:Name="RouteDetailText" Text="No board geometry is changed until both picks are accepted." Foreground="#59708E" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>
              <Button x:Name="UndoRouteButton" Content="Undo last route" Click="UndoRoute_Click" HorizontalAlignment="Left"/>
              <TextBlock Text="This is geometric trace creation, not clearance-aware autorouting. Conflicting endpoint net identity produces unassigned etch. Inspect the result and run the normal DRC." Foreground="#59708E" FontSize="11" Margin="0,18,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <Border x:Name="StatusBar" Grid.Row="2" MinHeight="28" Padding="12,5"
            Background="White" BorderBrush="#DCE7F5" BorderThickness="0,1,0,0">
      <TextBlock x:Name="StatusText"
                 Text="Open a board in Allegro and run pd_simple, or attach to a verified running board."
                 Foreground="#31465C" FontSize="11" TextWrapping="NoWrap"
                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
    </Border>
  </Grid>
</Window>

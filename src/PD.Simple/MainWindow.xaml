<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:corridor="clr-namespace:PD.Simple.Corridor"
        xmlns:engine="clr-namespace:PD.Simple.Engine"
        x:Class="PD.Simple.MainWindow"
        Title="PD Simple — Allegro Engine Showcase"
        Width="1260" Height="880" MinWidth="1120" MinHeight="760"
        Background="#F5F8FD" Foreground="#17243B" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#17243B"/>
      <Setter Property="BorderBrush" Value="#C9D8ED"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Margin" Value="0,0,0,7"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="#203041"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#31465C"/>
    </Style>
    <Style x:Key="FutureNavButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
      <Setter Property="IsEnabled" Value="False"/>
      <Setter Property="Opacity" Value="0.55"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="64"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Background="#101923" Padding="20,10">
      <DockPanel>
        <Button DockPanel.Dock="Right" x:Name="ReconnectButton" Content="Reconnect / Attach" Click="Reconnect_Click"
                ToolTip="Choose an open Allegro board or refresh the current connection. No operation is replayed."/>
        <Button DockPanel.Dock="Right" x:Name="ScreenshotButton" Width="42" Padding="0" Margin="0,0,8,0"
                Click="Screenshot_Click" ToolTip="Save a PNG of the PD Simple window and copy it to the clipboard"
                AutomationProperties.Name="Capture PD Simple window screenshot and copy path">
          <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
        </Button>
        <StackPanel>
          <TextBlock Text="PD Simple" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock x:Name="BoardText" Text="Allegro Engine showcase" Foreground="#93A9C0" FontSize="10"
                     TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="215"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Background="#16212D" Padding="12,15">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="ENGINE" Foreground="#7E98B3" FontSize="10" FontWeight="Bold" Margin="4,0,0,8"/>
            <Button x:Name="HomeMenuButton" Style="{StaticResource NavButton}" Content="Home / Capabilities" Click="Home_Click"/>
            <Button x:Name="ExplorerMenuButton" Style="{StaticResource NavButton}" Click="Explorer_Click">
              <StackPanel><TextBlock Text="Board Explorer"/><TextBlock Text="ENGINE" FontSize="9" Foreground="#6FD6A8"/></StackPanel>
            </Button>

            <TextBlock Text="ANALYZE" Foreground="#7E98B3" FontSize="10" FontWeight="Bold" Margin="4,10,0,8"/>
            <Button x:Name="CorridorMenuButton" Style="{StaticResource NavButton}" Click="Corridor_Click">
              <StackPanel><TextBlock Text="DP via corridor"/><TextBlock Text="LIVE" FontSize="9" Foreground="#6FD6A8"/></StackPanel>
            </Button>
            <Button Style="{StaticResource FutureNavButton}" Content="Crossing review  ·  coming"/>
            <Button Style="{StaticResource FutureNavButton}" Content="Geometry inspector  ·  coming"/>

            <TextBlock Text="INTERACT + EDIT" Foreground="#7E98B3" FontSize="10" FontWeight="Bold" Margin="4,10,0,8"/>
            <Button x:Name="RouteMenuButton" Style="{StaticResource NavButton}" Click="Route_Click">
              <StackPanel><TextBlock Text="Point-to-point trace"/><TextBlock Text="LIVE" FontSize="9" Foreground="#6FD6A8"/></StackPanel>
            </Button>
            <Button Style="{StaticResource FutureNavButton}" Content="Pick / measure / ruler  ·  integrating"/>
            <Button Style="{StaticResource FutureNavButton}" Content="Placement handles  ·  integrating"/>
            <Button Style="{StaticResource FutureNavButton}" Content="Via / route editing  ·  coming"/>

            <TextBlock Text="REVIEW + OFFLINE" Foreground="#7E98B3" FontSize="10" FontWeight="Bold" Margin="4,10,0,8"/>
            <Button Style="{StaticResource FutureNavButton}" Content="Live overlay tools  ·  integrating"/>
            <Button Style="{StaticResource FutureNavButton}" Content="Share / review view  ·  integrating"/>
            <Button Style="{StaticResource FutureNavButton}" Content="Captured scenes  ·  available in Explorer"/>

            <TextBlock Text="ALLEGRO DOMAINS" Foreground="#7E98B3" FontSize="10" FontWeight="Bold" Margin="4,10,0,8"/>
            <Button Style="{StaticResource FutureNavButton}" Content="Constraints / DRC  ·  coming"/>
            <Button Style="{StaticResource FutureNavButton}" Content="Physical symbols  ·  coming"/>
            <Button Style="{StaticResource FutureNavButton}" Content="Padstacks  ·  coming"/>
            <Button Style="{StaticResource FutureNavButton}" Content="Manufacturing  ·  coming"/>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Grid Grid.Column="1">
        <ScrollViewer x:Name="HomePanel" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="34" MaxWidth="920">
            <TextBlock Text="Allegro Engine showcase" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock Text="One C# application surface for exploring board data, running engineering analysis, interacting with Allegro, applying guarded edits, reviewing overlays, and opening captured scenes. The small standalone samples remain the learning path; PD Simple is the full reference host."
                       Foreground="#59708E" FontSize="14" Margin="0,0,0,24"/>

            <Border Background="#EAF4FF" BorderBrush="#C7DFFB" BorderThickness="1" CornerRadius="7" Padding="16" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="Architecture migration in progress" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Text="The target application API is AllegroBridge.Engine. Existing proven native operations stay available while their orchestration moves upward from PD Simple into Engine. Disabled capabilities below are visible intentionally; they do not claim native support before the matching Engine package and qualification exist."
                           Foreground="#45627F" Margin="0,5,0,0"/>
              </StackPanel>
            </Border>

            <TextBlock Text="Available now" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <UniformGrid Columns="3" Margin="0,0,0,24">
              <Button Click="Explorer_Click" Padding="18" HorizontalContentAlignment="Left" Margin="0,0,10,0">
                <StackPanel>
                  <TextBlock Text="Board Explorer" FontSize="17"/>
                  <TextBlock Text="Acquire typed Engine scenes, browse relationships, navigate semantic objects, and open/save offline captures." FontWeight="Normal" Foreground="#59708E" Margin="0,7,0,0"/>
                </StackPanel>
              </Button>
              <Button Click="Corridor_Click" Padding="18" HorizontalContentAlignment="Left" Margin="0,0,10,0">
                <StackPanel>
                  <TextBlock Text="DP via corridor" FontSize="17"/>
                  <TextBlock Text="Screen captured board data, review findings, navigate the verified native board, and export review evidence." FontWeight="Normal" Foreground="#59708E" Margin="0,7,0,0"/>
                </StackPanel>
              </Button>
              <Button Click="Route_Click" Padding="18" HorizontalContentAlignment="Left" Margin="0">
                <StackPanel>
                  <TextBlock Text="Point-to-point trace" FontSize="17"/>
                  <TextBlock Text="Pick actual endpoints, create one H-first trace, admit native readback, and retain edit-specific Undo/recovery." FontWeight="Normal" Foreground="#59708E" Margin="0,7,0,0"/>
                </StackPanel>
              </Button>
            </UniformGrid>

            <TextBlock Text="Engine capability map" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <UniformGrid Columns="3">
              <Border Background="White" BorderBrush="#DCE7F5" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,10,10">
                <StackPanel><TextBlock Text="Explore" FontWeight="SemiBold"/><TextBlock Text="Components · nets · pins · pairs · layers · route graph" Foreground="#59708E" Margin="0,4,0,0"/></StackPanel>
              </Border>
              <Border Background="White" BorderBrush="#DCE7F5" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,10,10">
                <StackPanel><TextBlock Text="Analyze" FontWeight="SemiBold"/><TextBlock Text="Crossings · geometry · measurements · findings" Foreground="#59708E" Margin="0,4,0,0"/></StackPanel>
              </Border>
              <Border Background="White" BorderBrush="#DCE7F5" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                <StackPanel><TextBlock Text="Interact" FontWeight="SemiBold"/><TextBlock Text="Picking · markers · rulers · snapping · draggable handles" Foreground="#59708E" Margin="0,4,0,0"/></StackPanel>
              </Border>
              <Border Background="White" BorderBrush="#DCE7F5" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,10,10">
                <StackPanel><TextBlock Text="Edit" FontWeight="SemiBold"/><TextBlock Text="Trace · placement · alignment · vias · recovery" Foreground="#59708E" Margin="0,4,0,0"/></StackPanel>
              </Border>
              <Border Background="White" BorderBrush="#DCE7F5" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,10,10">
                <StackPanel><TextBlock Text="Review" FontWeight="SemiBold"/><TextBlock Text="Overlay · annotations · composed share/export view" Foreground="#59708E" Margin="0,4,0,0"/></StackPanel>
              </Border>
              <Border Background="White" BorderBrush="#DCE7F5" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                <StackPanel><TextBlock Text="Offline" FontWeight="SemiBold"/><TextBlock Text="Capture scene · reopen · analyze without live edit authority" Foreground="#59708E" Margin="0,4,0,0"/></StackPanel>
              </Border>
            </UniformGrid>

            <TextBlock Text="Future domains stay visible: Constraints / DRC · Physical Symbols · Padstacks · Manufacturing. They remain disabled until their native producers and edit contracts are implemented and qualified."
                       Foreground="#59708E" FontSize="12" Margin="0,8,0,0"/>
          </StackPanel>
        </ScrollViewer>

        <engine:EngineExplorerView x:Name="ExplorerView" Visibility="Collapsed"/>
        <corridor:DpViaCorridorView x:Name="CorridorView" Visibility="Collapsed"/>

        <Grid x:Name="RoutePanel" Visibility="Collapsed" Margin="28">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Point-to-point trace" FontSize="27" FontWeight="Bold"/>
            <TextBlock Text="Create one H-first route between two actual Allegro picks. Native result admission and edit-specific recovery remain explicit while this workflow migrates into the Engine live workspace." Foreground="#59708E" Margin="0,8,0,0"/>
          </StackPanel>
          <Border Grid.Row="2" Background="White" BorderBrush="#DCE7F5" BorderThickness="1" CornerRadius="7" Padding="24" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="1. Choose trace width" FontSize="17" FontWeight="SemiBold"/>
              <StackPanel Orientation="Horizontal" Margin="0,12,0,6">
                <TextBox x:Name="WidthInput" Text="5" Width="120" Height="34" Padding="8,0" VerticalContentAlignment="Center" TextChanged="Width_Changed"/>
                <TextBlock Text="mil" Margin="10,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock x:Name="WidthError" Foreground="#B23D35" FontSize="11"/>
              <TextBlock Text="2. Pick the start, then the end in Allegro" FontSize="17" FontWeight="SemiBold" Margin="0,26,0,8"/>
              <TextBlock Text="The cursor ring shows native hit-test feedback. A blue marker holds the first pick. The route uses the clicked positions—not automatically the objects' centers." Foreground="#59708E"/>
              <WrapPanel Margin="0,18,0,0">
                <Button x:Name="StartRouteButton" Content="Select two objects" Click="StartRoute_Click" Background="#147CF8" Foreground="White"/>
                <Button x:Name="ClearPickButton" Content="Clear first pick" Click="ClearPick_Click"/>
                <Button x:Name="CancelRouteButton" Content="Cancel" Click="CancelRoute_Click"/>
              </WrapPanel>
              <Border Background="#EDF5FF" Padding="14" Margin="0,20,0,20" CornerRadius="5">
                <StackPanel>
                  <TextBlock x:Name="RoutePhaseText" Text="Ready when Allegro is connected" FontWeight="SemiBold"/>
                  <TextBlock x:Name="RouteDetailText" Text="No board geometry is changed until both picks are accepted." Foreground="#59708E" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>
              <Button x:Name="UndoRouteButton" Content="Undo last route" Click="UndoRoute_Click" HorizontalAlignment="Left"/>
              <TextBlock Text="This is geometric trace creation, not clearance-aware autorouting. Conflicting endpoint net identity produces unassigned etch. Inspect the result and run the normal DRC." Foreground="#59708E" FontSize="11" Margin="0,18,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="#EDF2F8" BorderBrush="#DCE7F5" BorderThickness="0,1,0,0" Padding="14,8">
      <TextBlock x:Name="StatusText" Text="Open a board in Allegro and run pd_simple, or attach to a verified running board." FontSize="11"/>
    </Border>
  </Grid>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:corridor="clr-namespace:PD.Simple.Corridor" x:Class="PD.Simple.MainWindow" Title="PD Simple" Width="1040" Height="850" MinWidth="1000" MinHeight="720" Background="#F5F8FD" Foreground="#17243B" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#17243B"/>
      <Setter Property="BorderBrush" Value="#C9D8ED"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="58"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Background="#101923" Padding="18,10">
      <DockPanel>
        <Button DockPanel.Dock="Right" x:Name="ReconnectButton" Content="Reconnect" Click="Reconnect_Click" ToolTip="Choose an open Allegro board or refresh the current connection. No operation is replayed."/>
        <StackPanel>
          <TextBlock Text="PD Simple" Foreground="White" FontSize="19" FontWeight="SemiBold"/>
          <TextBlock x:Name="BoardText" Text="Allegro Bridge SDK example" Foreground="#93A9C0" FontSize="10" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="125"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Background="#16212D" Padding="10,18">
        <StackPanel>
          <Button x:Name="CorridorMenuButton" Click="Corridor_Click" Margin="0,0,0,10" Padding="8,15">
            <TextBlock Text="DP via corridor" TextAlignment="Center"/>
          </Button>
          <Button x:Name="RouteMenuButton" Click="Route_Click" Margin="0" Padding="8,15">
            <TextBlock Text="Point-to-point trace" TextAlignment="Center"/>
          </Button>
        </StackPanel>
      </Border>
      <Grid Grid.Column="1">
        <StackPanel x:Name="HomePanel" Margin="40" VerticalAlignment="Center" MaxWidth="580">
          <TextBlock Text="Two tools. One SDK connection." FontSize="27" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <TextBlock Text="Choose a tool to work with the board open in Allegro." Foreground="#59708E" FontSize="14" Margin="0,0,0,28"/>
          <Button Click="Corridor_Click" Margin="0,0,0,14" Padding="18" HorizontalContentAlignment="Left">
            <StackPanel>
              <TextBlock Text="DP via corridor" FontSize="17"/>
              <TextBlock Text="Check, inspect crossings, highlight the native view, and export images." FontWeight="Normal" Foreground="#59708E" Margin="0,7,0,0"/>
            </StackPanel>
          </Button>
          <Button Click="Route_Click" Margin="0" Padding="18" HorizontalContentAlignment="Left">
            <StackPanel>
              <TextBlock Text="Point-to-point trace" FontSize="17"/>
              <TextBlock Text="Choose a width, then pick two objects in Allegro to create one route." FontWeight="Normal" Foreground="#59708E" Margin="0,7,0,0"/>
            </StackPanel>
          </Button>
          <TextBlock Text="Launch from Allegro with pd_simple, or choose Reconnect to attach to an open PD Simple board. A full Workflow Engine installation is not needed; the Bridge SDK's entitlement requirements still apply." FontSize="11" Foreground="#59708E" Margin="0,28,0,0"/>
        </StackPanel>
        <corridor:DpViaCorridorView x:Name="CorridorView" Visibility="Collapsed"/>
        <Grid x:Name="RoutePanel" Visibility="Collapsed" Margin="28">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Point-to-point trace" FontSize="27" FontWeight="Bold"/>
            <TextBlock Text="Create one H-first route between two objects. Use a visible active ETCH layer; otherwise the first visible ETCH layer is used." Foreground="#59708E" Margin="0,8,0,0"/>
          </StackPanel>
          <Border Grid.Row="2" Background="White" BorderBrush="#DCE7F5" BorderThickness="1" CornerRadius="7" Padding="24" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="1. Choose trace width" FontSize="17" FontWeight="SemiBold"/>
              <StackPanel Orientation="Horizontal" Margin="0,12,0,6">
                <TextBox x:Name="WidthInput" Text="5" Width="120" Height="34" Padding="8,0" VerticalContentAlignment="Center" TextChanged="Width_Changed"/>
                <TextBlock Text="mil" Margin="10,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock x:Name="WidthError" Foreground="#B23D35" FontSize="11"/>
              <TextBlock Text="2. Pick the start, then the end in Allegro" FontSize="17" FontWeight="SemiBold" Margin="0,26,0,8"/>
              <TextBlock Text="The cursor ring shows native hit-test feedback. A blue marker holds the first pick. The route uses the clicked positions—not automatically the objects' centers." Foreground="#59708E"/>
              <WrapPanel Margin="0,18,0,0">
                <Button x:Name="StartRouteButton" Content="Select two objects" Click="StartRoute_Click" Background="#147CF8" Foreground="White"/>
                <Button x:Name="ClearPickButton" Content="Clear first pick" Click="ClearPick_Click"/>
                <Button x:Name="CancelRouteButton" Content="Cancel" Click="CancelRoute_Click"/>
              </WrapPanel>
              <Border Background="#EDF5FF" Padding="14" Margin="0,20,0,20" CornerRadius="5">
                <StackPanel>
                  <TextBlock x:Name="RoutePhaseText" Text="Ready when Allegro is connected" FontWeight="SemiBold"/>
                  <TextBlock x:Name="RouteDetailText" Text="No board geometry is changed until both picks are accepted." Foreground="#59708E" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>
              <Button x:Name="UndoRouteButton" Content="Undo last route" Click="UndoRoute_Click" HorizontalAlignment="Left"/>
              <TextBlock Text="A shared net creates a net cline; conflicting or unavailable net identity creates unassigned etch. This is geometric trace creation, not clearance-aware autorouting. Inspect the result and run your normal DRC." Foreground="#59708E" FontSize="11" Margin="0,18,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="#EDF2F8" BorderBrush="#DCE7F5" BorderThickness="0,1,0,0" Padding="14,8">
      <TextBlock x:Name="StatusText" Text="Open a board in Allegro and run pd_simple." FontSize="11"/>
    </Border>
  </Grid>
</Window>

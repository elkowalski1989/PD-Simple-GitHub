<Window x:Class="PD.Simple.BoardConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect to Allegro" Width="720" Height="490"
        MinWidth="660" MinHeight="430"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F5F8FD" Foreground="#17243B" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#17243B"/>
            <Setter Property="BorderBrush" Value="#C9D8ED"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="CandidateCellText" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,9"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="#101923" Padding="20,14">
            <StackPanel>
                <TextBlock Text="Connect to an open board" Foreground="White"
                           FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="CurrentConnectionText" Foreground="#93A9C0"
                           Margin="0,5,0,0" FontSize="12"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
                <Button x:Name="RefreshConnectionsButton" Content="Refresh" DockPanel.Dock="Right"
                        AutomationProperties.AutomationId="RefreshConnectionsButton"
                        Click="RefreshConnections_Click" Margin="16,0,0,0"/>
                <TextBlock Text="Select an Allegro instance to attach to its open board."
                           VerticalAlignment="Center" Foreground="#59708E"/>
            </DockPanel>
            <DataGrid x:Name="ConnectionCandidateList" Grid.Row="1"
                      AutomationProperties.AutomationId="ConnectionCandidateList"
                      AutomationProperties.Name="Open Allegro boards"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserReorderColumns="False" HeadersVisibility="Column"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF2F8"
                      Background="White" BorderBrush="#C9D8ED" BorderThickness="1"
                      SelectionChanged="ConnectionCandidateList_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Design" Binding="{Binding Design}" Width="2*"
                                        ElementStyle="{StaticResource CandidateCellText}"/>
                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="80"
                                        ElementStyle="{StaticResource CandidateCellText}"/>
                    <DataGridTextColumn Header="Availability" Binding="{Binding Availability}" Width="3*"
                                        ElementStyle="{StaticResource CandidateCellText}"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="ConnectionStatusText" Grid.Row="2" Margin="0,12,0,0"
                       AutomationProperties.AutomationId="ConnectionStatusText"
                       AutomationProperties.LiveSetting="Polite"
                       Foreground="#59708E" Text="Looking for open Allegro boards…"/>
        </Grid>
        <Border Grid.Row="2" Background="#EDF2F8" BorderBrush="#DCE7F5"
                BorderThickness="0,1,0,0" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="ReconnectCurrentButton" Content="Reconnect current"
                        AutomationProperties.AutomationId="ReconnectCurrentButton"
                        Click="ReconnectCurrent_Click" HorizontalAlignment="Left"/>
                <Button x:Name="AttachConnectionButton" Grid.Column="1" Content="Attach selected"
                        AutomationProperties.AutomationId="AttachConnectionButton"
                        Click="AttachConnection_Click" IsEnabled="False" IsDefault="True"
                        Background="#147CF8" Foreground="White" Margin="12,0,8,0"/>
                <Button x:Name="CancelConnectionButton" Grid.Column="2" Content="Cancel"
                        AutomationProperties.AutomationId="CancelConnectionButton"
                        IsCancel="True"/>
            </Grid>
        </Border>
    </Grid>
</Window>

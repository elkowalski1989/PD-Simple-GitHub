<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PD.Simple.Corridor" x:Class="PD.Simple.Corridor.DpViaCorridorView" Background="#F5F8FD" Foreground="#17243B" FontSize="11">
  <UserControl.Resources>
    <SolidColorBrush x:Key="DpvInk" Color="#17243B"/>
    <SolidColorBrush x:Key="DpvMuted" Color="#59708E"/>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource DpvInk}"/>
    </Style>
    <Style x:Key="DpvCaption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource DpvMuted}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="DpvSelectableCaption" TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource DpvMuted}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Height" Value="Auto"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="IsReadOnlyCaretVisible" Value="True"/>
      <Setter Property="Cursor" Value="IBeam"/>
    </Style>
    <DataTemplate x:Key="DpvLabel">
      <TextBlock Text="{Binding}" Foreground="{StaticResource DpvInk}"/>
    </DataTemplate>
    <Style x:Key="DpvCard" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#DCE7F5"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="12"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{StaticResource DpvInk}"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#C9D8ED"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="10"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource DpvInk}"/>
      <Setter Property="ContentTemplate" Value="{StaticResource DpvLabel}"/>
    </Style>
    <Style TargetType="Expander">
      <Setter Property="Foreground" Value="{StaticResource DpvInk}"/>
      <Setter Property="HeaderTemplate" Value="{StaticResource DpvLabel}"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="30"/>
      <Setter Property="Foreground" Value="{StaticResource DpvInk}"/>
      <Setter Property="ItemTemplate" Value="{StaticResource DpvLabel}"/>
      <Setter Property="FontSize" Value="10"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Foreground" Value="{StaticResource DpvInk}"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#C8D8EE"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </DataTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.8"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#147CF8"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DpvRiskBadge" TargetType="Border">
      <Setter Property="Background" Value="#DDEEFF"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Padding" Value="4,2"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Risk}" Value="CRITICAL">
          <Setter Property="Background" Value="#FFE0DC"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Risk}" Value="MEDIUM">
          <Setter Property="Background" Value="#FFF0CB"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="10"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="10"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="220"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="140"/>
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
        <TextBlock Text="Signal Integrity  ›  DP via corridor" FontSize="10" Foreground="#48688D" Margin="0,0,0,8"/>
        <TextBlock Text="DP Via Corridor" FontSize="25" FontWeight="Bold"/>
        <TextBlock Text="Find foreign conductors between P and N vias." Style="{StaticResource DpvCaption}" Margin="0,5,0,0"/>
      </StackPanel>
      <Border x:Name="DpvHelpCard" Grid.Column="1" Style="{StaticResource DpvCard}" Background="#EDF5FF" BorderBrush="#C9DFFF" Padding="10">
        <StackPanel>
          <TextBlock Text="What does this check?" FontSize="11" FontWeight="SemiBold" Foreground="#0865CE"/>
          <TextBlock x:Name="DpvHelpText" Text="Looks for other signals inside the corridor between a differential pair’s P and N vias." Style="{StaticResource DpvCaption}" Margin="0,5,0,0"/>
          <TextBlock Text="Risk labels guide review—not SI sign-off." FontSize="9" Foreground="#48688D" Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="3" Style="{StaticResource DpvCard}" Padding="10" Background="#F8FAFE">
        <StackPanel>
          <TextBlock Text="Board context" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding BoardDisplay}" ToolTip="{Binding BoardDisplay}" FontSize="10" Foreground="{StaticResource DpvMuted}" TextTrimming="CharacterEllipsis" Margin="0,6,0,8"/>
          <Button x:Name="DpvBackButton" Content="Tools" Height="26" Click="Back_Click" IsEnabled="{Binding IsInputEnabled}"/>
        </StackPanel>
      </Border>
    </Grid>
    <Border Grid.Row="2" Style="{StaticResource DpvCard}" Padding="12,9">
      <UniformGrid Columns="3">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="34"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Width="28" Height="28" CornerRadius="14" Background="#147CF8">
            <TextBlock Text="1" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="5,0,12,0">
            <TextBlock Text="Set up" FontWeight="SemiBold" Foreground="#076BDA"/>
            <TextBlock Text="Choose options and run the check" FontSize="9" Foreground="{StaticResource DpvMuted}" Margin="0,3,0,0"/>
          </StackPanel>
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="34"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Width="28" Height="28" CornerRadius="14" Background="#DFE9F5">
            <TextBlock Text="2" Foreground="#3E5A7A" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="5,0,12,0">
            <TextBlock Text="Inspect" FontWeight="SemiBold"/>
            <TextBlock Text="Review captured crossings" FontSize="9" Foreground="{StaticResource DpvMuted}" Margin="0,3,0,0"/>
          </StackPanel>
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="34"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Width="28" Height="28" CornerRadius="14" Background="#DFE9F5">
            <TextBlock Text="3" Foreground="#3E5A7A" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="5,0,0,0">
            <TextBlock Text="Report" FontWeight="SemiBold"/>
            <TextBlock Text="Open the full analysis report" FontSize="9" Foreground="{StaticResource DpvMuted}" Margin="0,3,0,0"/>
          </StackPanel>
        </Grid>
      </UniformGrid>
    </Border>
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="205"/>
        <ColumnDefinition Width="9"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="9"/>
        <ColumnDefinition Width="310"/>
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource DpvCard}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,15">
            <TextBlock Text="1. Set up" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Choose how to run the check." Style="{StaticResource DpvCaption}" Margin="0,5,0,0"/>
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,3,0">
              <StackPanel IsEnabled="{Binding IsInputEnabled}">
                <TextBlock Text="Extra corridor margin" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="25"/>
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="DpvMarginInput" Text="{Binding MarginMils, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Extra corridor margin in mils"/>
                  <TextBlock Grid.Column="1" Text="mil" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource DpvMuted}"/>
                </Grid>
                <TextBlock Text="0–50 mils beyond the pad edge. Zero uses the native pad-based corridor." Style="{StaticResource DpvCaption}" Margin="0,6,0,0"/>
                <TextBlock Text="Component filter (optional)" FontWeight="SemiBold" Margin="0,18,0,6"/>
                <TextBox x:Name="DpvModuleInput" Text="{Binding ModuleFilter, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" AutomationProperties.Name="Optional component reference filter"/>
                <TextBlock Text="For example, U12. Leave blank to check all differential pairs." Style="{StaticResource DpvCaption}" Margin="0,6,0,0"/>
                <CheckBox x:Name="DpvUnusedToggle" Content="Include unused pairs" Margin="0,17,0,0" IsChecked="{Binding IncludeUnused}" FontSize="11"/>
                <TextBlock Text="Also checks NC/NU differential pairs." Style="{StaticResource DpvCaption}" Margin="0,5,0,0"/>
              </StackPanel>
              <TextBlock x:Name="DpvInputError" Text="{Binding InputError}" Foreground="#B83232" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>
              <Border Background="#EDF5FF" CornerRadius="6" Padding="10" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock Text="Report-only analysis" FontWeight="SemiBold" Foreground="#0865CE"/>
                  <TextBlock Text="Existing checker. C# highlights do not change board data; reports are saved automatically." Style="{StaticResource DpvCaption}" Margin="0,5,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <Border Padding="8" CornerRadius="5" Margin="0,0,0,8" ToolTip="{Binding StatusDetail}">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="#EDF5FF"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasProblem}" Value="True">
                      <Setter Property="Background" Value="#FFF0ED"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <StackPanel>
                <TextBlock x:Name="DpvStatusTitle" Text="{Binding StatusTitle}" FontWeight="SemiBold" FontSize="10" TextWrapping="Wrap"/>
                <DockPanel Margin="0,5,0,0">
                  <Button x:Name="DpvCopyStatusButton" DockPanel.Dock="Right" Content="Copy" Height="22" Padding="7,0" Margin="7,0,0,0" VerticalAlignment="Top" Click="CopyStatus_Click" ToolTip="Copy the setup status to the clipboard" AutomationProperties.Name="Copy setup status"/>
                  <TextBox x:Name="DpvStatusDetailBox" Text="{Binding StatusDetail, Mode=OneWay}" Style="{StaticResource DpvSelectableCaption}"/>
                </DockPanel>
              </StackPanel>
            </Border>
            <ProgressBar Height="3" Margin="0,0,0,7" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button x:Name="DpvRunButton" Height="38" Background="#147CF8" BorderBrush="#147CF8" Foreground="White" Content="{Binding RunLabel}" Command="{Binding RunCommand}" AutomationProperties.Name="Run DP via corridor analysis"/>
            <TextBlock Text="{Binding RunAvailability}" Style="{StaticResource DpvCaption}" FontSize="9" Margin="0,7,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource DpvCard}" Padding="10,12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,10">
            <TextBlock Text="2. Inspect" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Current Engine/WPF review capture or measured fallback." Style="{StaticResource DpvCaption}" Margin="0,5,0,0"/>
          </StackPanel>
          <Border Grid.Row="1" Background="#EDF4FD" BorderBrush="#DCE7F5" BorderThickness="1" CornerRadius="5" Padding="7" Margin="0,0,0,6">
            <StackPanel>
              <DockPanel>
                <Button x:Name="DpvFitButton" Content="Fit" DockPanel.Dock="Right" Height="25" Click="Fit_Click"/>
                <TextBlock Text="{Binding PreviewTitle}" FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center"/>
              </DockPanel>
              <CheckBox x:Name="DpvFollowSelectionToggle" Content="Follow selection in Allegro" IsChecked="{Binding FollowSelection}" Margin="0,7,0,0" FontSize="9"/>
              <Button x:Name="DpvZoomButton" Content="Zoom in Allegro" Command="{Binding ZoomCommand}" ToolTip="{Binding ZoomAvailability}" Height="28" Margin="0,7,0,0" AutomationProperties.Name="Browse selected crossing in Allegro and capture its view"/>
              <Button x:Name="DpvRevalidateButton" Content="Revalidate crossing" Command="{Binding RevalidateCommand}" ToolTip="Recheck the selected witnesses against a fresh region and capture its view. This does not rerun the crossing analysis." Height="25" Margin="0,6,0,0" AutomationProperties.Name="Revalidate selected crossing in Allegro"/>
              <TextBlock Text="{Binding NavigationModeDisplay}" Style="{StaticResource DpvCaption}" FontSize="9" Margin="0,5,0,0"/>
              <CheckBox x:Name="DpvAutoDebugImagesToggle" Content="Auto-capture overlay debug images" IsChecked="{Binding AutoCaptureDebugImages}" Margin="0,7,0,0" FontSize="9" ToolTip="Write a window PNG, hash, JSON receipt, and prune old files on overlay-state changes. Off by default; enabling adds synchronous UI-thread file I/O to every overlay transition."/>
              <DockPanel Margin="0,6,0,0">
                <Button x:Name="DpvSaveImageButton" DockPanel.Dock="Right" Content="Save PNG" Height="25" Padding="7,2" IsEnabled="{Binding HasCapturedReview}" Click="SaveImage_Click" ToolTip="Save the facade-composed canonical drawing when highlighting is on; save immutable raw capture pixels when it is off." AutomationProperties.Name="Save current captured review as PNG"/>
                <CheckBox x:Name="DpvShowCorridorToggle" Content="Show corridor highlighting" IsChecked="{Binding ShowHighlighting}" VerticalAlignment="Center" FontSize="9" ToolTip="Measured corridor, P/N via centers, and reported intrusion in the preview and active Allegro canvas. These annotations do not change board copper."/>
              </DockPanel>
              <TextBlock Text="{Binding BoardOverlayStatus}" Style="{StaticResource DpvCaption}" FontSize="9" Margin="0,5,0,0" Visibility="{Binding HasCapturedReview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
              <ProgressBar Height="3" IsIndeterminate="True" Margin="0,7,0,0" Visibility="{Binding IsNavigating, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
          </Border>
          <local:DpViaCorridorCanvas x:Name="DpvCanvas" Grid.Row="2" MinHeight="160" Finding="{Binding SelectedFinding}" ReviewCapture="{Binding CapturedReview}" HasAnalysis="{Binding HasResult}" ShowCorridor="{Binding IsChecked, ElementName=DpvShowCorridorToggle}" AutomationProperties.Name="Captured Allegro review or measured DP corridor geometry"/>
          <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <DockPanel Margin="0,0,0,7">
              <Button x:Name="DpvCopyPreviewButton" DockPanel.Dock="Right" Content="Copy" Height="22" Padding="7,0" Margin="7,0,0,0" VerticalAlignment="Top" Click="CopyPreviewStatus_Click" ToolTip="Copy the preview status to the clipboard" AutomationProperties.Name="Copy preview status"/>
              <TextBox x:Name="DpvPreviewStatus" Text="{Binding PreviewStatus, Mode=OneWay}" Style="{StaticResource DpvSelectableCaption}" FontSize="9"/>
            </DockPanel>
            <TextBlock Text="{Binding SelectedFindingTitle}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedFindingTitle}"/>
            <DockPanel Margin="0,3,0,0">
              <Button x:Name="DpvCopyFindingButton" DockPanel.Dock="Right" Content="Copy" Height="22" Padding="7,0" Margin="7,0,0,0" VerticalAlignment="Center" Click="CopyFindingDetail_Click" ToolTip="Copy the finding detail to the clipboard" AutomationProperties.Name="Copy finding detail"/>
              <TextBox x:Name="DpvFindingDetailBox" Text="{Binding SelectedFindingDetail, Mode=OneWay}" Style="{StaticResource DpvSelectableCaption}" FontSize="9" TextWrapping="NoWrap" ToolTip="{Binding SelectedFindingDetail}" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="{Binding ResultProvenance}" Style="{StaticResource DpvCaption}" FontSize="9" Margin="0,7,0,0"/>
            <TextBlock Text="{Binding ResultScope}" Style="{StaticResource DpvCaption}" FontSize="9" Margin="0,4,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="4" Style="{StaticResource DpvCard}" Padding="10,12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,10">
            <TextBlock Text="3. Review crossings" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Results from the captured analysis." Style="{StaticResource DpvCaption}" Margin="0,5,0,0"/>
          </StackPanel>
          <StackPanel Grid.Row="1">
            <UniformGrid Columns="3">
              <Border Style="{StaticResource DpvCard}" Background="#F8FAFE" Padding="8" Margin="0,0,5,0">
                <StackPanel>
                  <TextBlock Text="Pairs" Style="{StaticResource DpvCaption}"/>
                  <TextBlock Text="{Binding PairCountDisplay}" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource DpvCard}" Background="#F8FAFE" Padding="8" Margin="0,0,5,0">
                <StackPanel>
                  <TextBlock Text="Corridors" Style="{StaticResource DpvCaption}"/>
                  <TextBlock Text="{Binding CorridorCountDisplay}" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource DpvCard}" Background="#F8FAFE" Padding="8">
                <StackPanel>
                  <TextBlock Text="Crossings" Style="{StaticResource DpvCaption}"/>
                  <TextBlock Text="{Binding FindingCountDisplay}" FontSize="24" FontWeight="Bold" Foreground="#C43E36"/>
                </StackPanel>
              </Border>
            </UniformGrid>
            <TextBlock Text="{Binding RiskSummary}" Style="{StaticResource DpvCaption}" FontSize="9" Margin="0,6,0,0"/>
          </StackPanel>
          <StackPanel Grid.Row="2" Margin="0,10,0,6">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="7"/>
                <ColumnDefinition Width="91"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="DpvSearchInput" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search crossings by aggressor, pair, layer or category" AutomationProperties.Name="Search corridor findings" Height="30"/>
              <ComboBox x:Name="DpvRiskFilter" Grid.Column="2" ItemsSource="{Binding RiskOptions}" SelectedItem="{Binding RiskFilter}" AutomationProperties.Name="Filter crossing risk"/>
            </Grid>
            <DockPanel Margin="0,5,0,6">
              <Button DockPanel.Dock="Right" Content="Reset" Height="22" Command="{Binding ClearFiltersCommand}"/>
              <TextBlock Text="Search crossings" FontSize="9" Foreground="{StaticResource DpvMuted}" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding FindingListSummary}" FontSize="9" Foreground="{StaticResource DpvMuted}" VerticalAlignment="Center" Margin="9,0,0,0"/>
            </DockPanel>
            <Grid Margin="6,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="43"/>
                <ColumnDefinition Width="51"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Interfering net" FontSize="9" Foreground="#48688D"/>
              <TextBlock Grid.Column="1" Text="Pair" FontSize="9" Foreground="#48688D"/>
              <TextBlock Grid.Column="2" Text="Layer" FontSize="9" Foreground="#48688D"/>
              <TextBlock Grid.Column="3" Text="Risk" FontSize="9" Foreground="#48688D"/>
            </Grid>
          </StackPanel>
          <Grid Grid.Row="3" MinHeight="90">
            <ListBox x:Name="DpvFindingList" ItemsSource="{Binding VisibleFindings}" SelectedItem="{Binding SelectedFinding, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Captured DP corridor crossings">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  <Setter Property="Padding" Value="0"/>
                  <Setter Property="Margin" Value="0,0,0,2"/>
                  <Setter Property="Background" Value="#FAFCFF"/>
                  <Setter Property="BorderBrush" Value="#EDF2FA"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5,7">
                          <ContentPresenter/>
                        </Border>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                  <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter Property="Background" Value="#EAF3FF"/>
                      <Setter Property="BorderBrush" Value="#147CF8"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="BorderBrush" Value="#87B6EE"/>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="1.2*"/>
                      <ColumnDefinition Width="1*"/>
                      <ColumnDefinition Width="43"/>
                      <ColumnDefinition Width="51"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding AggressorNet}" ToolTip="{Binding AggressorNet}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource DpvInk}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding PairName}" ToolTip="{Binding PairName}" FontSize="9" Foreground="{StaticResource DpvInk}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding Layer}" ToolTip="{Binding Layer}" FontSize="9" Foreground="{StaticResource DpvMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Border Grid.Column="3" Style="{StaticResource DpvRiskBadge}" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Risk}" Foreground="#533B34" FontSize="7.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Margin="8,12" VerticalAlignment="Top">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasVisibleFindings}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBlock Text="{Binding EmptyResultsTitle}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding EmptyResultsDetail}" Style="{StaticResource DpvCaption}" Margin="0,7,0,0"/>
            </StackPanel>
          </Grid>
          <Border x:Name="DpvDetailsCard" Grid.Row="4" Background="#F8FAFE" BorderBrush="#DCE7F5" BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,9,0,0">
            <Border.Style>
              <Style TargetType="Border">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedFinding}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel>
              <TextBlock Text="Crossing details" FontWeight="SemiBold" Margin="0,0,0,7"/>
              <Grid DataContext="{Binding SelectedFinding}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="80"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="20"/>
                  <RowDefinition Height="20"/>
                  <RowDefinition Height="20"/>
                  <RowDefinition Height="20"/>
                  <RowDefinition Height="20"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Interfering net" Style="{StaticResource DpvCaption}"/>
                <TextBlock x:Name="DpvDetailNet" Grid.Column="1" Text="{Binding AggressorNet}" ToolTip="{Binding AggressorNet}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="#B23D35"/>
                <TextBlock Grid.Row="1" Text="Differential pair" Style="{StaticResource DpvCaption}"/>
                <TextBlock x:Name="DpvDetailPair" Grid.Row="1" Grid.Column="1" Text="{Binding PairName}" ToolTip="{Binding PairName}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Row="2" Text="Layer" Style="{StaticResource DpvCaption}"/>
                <TextBlock x:Name="DpvDetailLayer" Grid.Row="2" Grid.Column="1" Text="{Binding Layer}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Row="3" Text="Location · mil" Style="{StaticResource DpvCaption}"/>
                <TextBlock x:Name="DpvDetailLocation" Grid.Row="3" Grid.Column="1" FontSize="9" TextTrimming="CharacterEllipsis">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="X: {0:0.##}   Y: {1:0.##}" FallbackValue="Not supplied">
                      <Binding Path="Intrusion.XMil" FallbackValue="—"/>
                      <Binding Path="Intrusion.YMil" FallbackValue="—"/>
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
                <TextBlock Grid.Row="4" Text="Risk" Style="{StaticResource DpvCaption}"/>
                <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource DpvRiskBadge}" HorizontalAlignment="Left" VerticalAlignment="Top">
                  <TextBlock Text="{Binding Risk}" FontSize="8" FontWeight="SemiBold" Foreground="#533B34"/>
                </Border>
              </Grid>
            </StackPanel>
          </Border>
          <Grid Grid.Row="5" Margin="0,9,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="7"/>
              <ColumnDefinition Width="95"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="DpvOpenReportButton" Content="Open full report" Command="{Binding OpenReportCommand}"/>
            <Button Grid.Column="2" Content="Run again" Command="{Binding RunCommand}" Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>

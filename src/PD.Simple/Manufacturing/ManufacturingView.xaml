<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PD.Simple.Manufacturing" x:Class="PD.Simple.Manufacturing.ManufacturingView" Background="#F5F8FD" Foreground="#17243B" FontSize="11">
  <UserControl.Resources>
    <SolidColorBrush x:Key="MfgInk" Color="#17243B"/>
    <SolidColorBrush x:Key="MfgMuted" Color="#59708E"/>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MfgInk}"/>
    </Style>
    <Style x:Key="MfgCaption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MfgMuted}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="MfgCard" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#DCE7F5"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{StaticResource MfgInk}"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#C9D8ED"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="10"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="30"/>
      <Setter Property="Foreground" Value="{StaticResource MfgInk}"/>
      <Setter Property="FontSize" Value="10"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Foreground" Value="{StaticResource MfgInk}"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#C8D8EE"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource MfgInk}"/>
      <Setter Property="Margin" Value="0,0,12,4"/>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource MfgInk}"/>
      <Setter Property="Margin" Value="0,0,16,0"/>
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16">
      <TextBlock Text="Manufacturing output" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
      <TextBlock Style="{StaticResource MfgCaption}" Text="Real Artwork/Gerber, ODB++ and IPC-2581 workflows: fence the saved source, preview the manifest, generate into isolated staging, validate, then approve promotion. The page opens while disconnected; only safe actions stay enabled." Margin="0,0,0,8"/>

      <Border Style="{StaticResource MfgCard}">
        <StackPanel>
          <TextBlock Text="1 · Source" FontWeight="Bold" Margin="0,0,0,4"/>
          <TextBlock x:Name="MfgSourceStatusText" AutomationProperties.AutomationId="MfgSourceStatusText" Style="{StaticResource MfgCaption}" Text="Not connected."/>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="MfgRefreshSourceButton" AutomationProperties.AutomationId="MfgRefreshSourceButton" Content="Refresh source fence" Click="MfgRefreshSourceButton_Click"/>
          </StackPanel>
          <TextBlock x:Name="MfgSetupNoticeText" AutomationProperties.AutomationId="MfgSetupNoticeText" Style="{StaticResource MfgCaption}" Margin="0,8,0,0" Text="Connect to Allegro with a board open. Planning needs the canonical SHA-256 of the saved board bytes; unsaved live edits are never exported."/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource MfgCard}">
        <StackPanel>
          <TextBlock Text="2 · Format and plan" FontWeight="Bold" Margin="0,0,0,4"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton x:Name="MfgFormatArtwork" AutomationProperties.AutomationId="MfgFormatArtwork" Content="Artwork / Gerber" IsChecked="True" Checked="MfgFormat_Checked"/>
            <RadioButton x:Name="MfgFormatOdb" AutomationProperties.AutomationId="MfgFormatOdb" Content="ODB++" Checked="MfgFormat_Checked"/>
            <RadioButton x:Name="MfgFormatIpc" AutomationProperties.AutomationId="MfgFormatIpc" Content="IPC-2581" Checked="MfgFormat_Checked"/>
          </StackPanel>

          <StackPanel x:Name="MfgArtworkPanel" AutomationProperties.AutomationId="MfgArtworkPanel">
            <TextBlock Style="{StaticResource MfgCaption}" Text="Films, one per line: name | layers (comma separated) | artifact path | polarity (+/-) | mirror (true/false)"/>
            <TextBox x:Name="MfgFilmsText" AutomationProperties.AutomationId="MfgFilmsText" Height="72" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="8" Text="TOP | ETCH/TOP | films/top.gbr | + | false"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <StackPanel Margin="0,0,12,0">
                <TextBlock Style="{StaticResource MfgCaption}" Text="Gerber format"/>
                <ComboBox x:Name="MfgArtworkFormatCombo" AutomationProperties.AutomationId="MfgArtworkFormatCombo" Width="150"/>
              </StackPanel>
              <StackPanel Margin="0,0,12,0">
                <TextBlock Style="{StaticResource MfgCaption}" Text="Units"/>
                <ComboBox x:Name="MfgArtworkUnitsCombo" AutomationProperties.AutomationId="MfgArtworkUnitsCombo" Width="150"/>
              </StackPanel>
              <StackPanel Margin="0,0,12,0">
                <TextBlock Style="{StaticResource MfgCaption}" Text="Outline offset (mils, optional)"/>
                <TextBox x:Name="MfgOutlineOffsetText" AutomationProperties.AutomationId="MfgOutlineOffsetText" Width="150"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Style="{StaticResource MfgCaption}" Text="Min aperture (mils 1-3, optional)"/>
                <TextBox x:Name="MfgMinApertureText" AutomationProperties.AutomationId="MfgMinApertureText" Width="150"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <CheckBox x:Name="MfgSuppressFillCheck" AutomationProperties.AutomationId="MfgSuppressFillCheck" Content="Suppress negative fill (-s)"/>
              <CheckBox x:Name="MfgVectorPadCheck" AutomationProperties.AutomationId="MfgVectorPadCheck" Content="Vector pad behavior (-p)"/>
            </StackPanel>
            <TextBlock Style="{StaticResource MfgCaption}" Text="art_param.txt (required caller-owned configuration)" Margin="0,8,0,0"/>
            <TextBox x:Name="MfgArtParamText" AutomationProperties.AutomationId="MfgArtParamText" Height="56" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="8"/>
            <TextBlock Style="{StaticResource MfgCaption}" Text="art_aper.txt (optional)" Margin="0,8,0,0"/>
            <TextBox x:Name="MfgArtAperText" AutomationProperties.AutomationId="MfgArtAperText" Height="40" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="8"/>
          </StackPanel>

          <StackPanel x:Name="MfgOdbPanel" AutomationProperties.AutomationId="MfgOdbPanel" Visibility="Collapsed">
            <TextBlock Style="{StaticResource MfgCaption}" Text="Step name"/>
            <TextBox x:Name="MfgOdbStepText" AutomationProperties.AutomationId="MfgOdbStepText" Text="primary"/>
            <TextBlock Style="{StaticResource MfgCaption}" Text="Layers (comma separated)" Margin="0,8,0,0"/>
            <TextBox x:Name="MfgOdbLayersText" AutomationProperties.AutomationId="MfgOdbLayersText" Text="ETCH/TOP, ETCH/BOTTOM"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <StackPanel Margin="0,0,12,0">
                <TextBlock Style="{StaticResource MfgCaption}" Text="Padflash"/>
                <ComboBox x:Name="MfgOdbPadflashCombo" AutomationProperties.AutomationId="MfgOdbPadflashCombo" Width="150"/>
              </StackPanel>
              <StackPanel Margin="0,0,12,0">
                <TextBlock Style="{StaticResource MfgCaption}" Text="Outline source"/>
                <ComboBox x:Name="MfgOdbOutlineCombo" AutomationProperties.AutomationId="MfgOdbOutlineCombo" Width="150"/>
              </StackPanel>
              <StackPanel Margin="0,0,12,0">
                <TextBlock Style="{StaticResource MfgCaption}" Text="Thermal file (optional)"/>
                <TextBox x:Name="MfgOdbThermalFileText" AutomationProperties.AutomationId="MfgOdbThermalFileText" Width="170"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Style="{StaticResource MfgCaption}" Text="Thermal name (with file)"/>
                <TextBox x:Name="MfgOdbThermalNameText" AutomationProperties.AutomationId="MfgOdbThermalNameText" Width="170"/>
              </StackPanel>
            </StackPanel>
            <TextBlock Style="{StaticResource MfgCaption}" Text="Headless ODB++ export has no supported native operation in the installed product; planning, staging and validation stay available and execution reports NoGo with its evidence." Margin="0,8,0,0"/>
          </StackPanel>

          <StackPanel x:Name="MfgIpcPanel" AutomationProperties.AutomationId="MfgIpcPanel" Visibility="Collapsed">
            <TextBlock Style="{StaticResource MfgCaption}" Text="Layers (comma separated)"/>
            <TextBox x:Name="MfgIpcLayersText" AutomationProperties.AutomationId="MfgIpcLayersText" Text="ETCH/TOP, ETCH/BOTTOM"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <StackPanel Margin="0,0,12,0">
                <TextBlock Style="{StaticResource MfgCaption}" Text="Artifact (.xml)"/>
                <TextBox x:Name="MfgIpcArtifactText" AutomationProperties.AutomationId="MfgIpcArtifactText" Width="220" Text="ipc/job.xml"/>
              </StackPanel>
              <StackPanel Margin="0,0,12,0">
                <TextBlock Style="{StaticResource MfgCaption}" Text="Revision"/>
                <ComboBox x:Name="MfgIpcRevisionCombo" AutomationProperties.AutomationId="MfgIpcRevisionCombo" Width="120"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Style="{StaticResource MfgCaption}" Text="Units"/>
                <ComboBox x:Name="MfgIpcUnitsCombo" AutomationProperties.AutomationId="MfgIpcUnitsCombo" Width="150"/>
              </StackPanel>
            </StackPanel>
            <TextBlock Style="{StaticResource MfgCaption}" Text="Content" Margin="0,8,0,0"/>
            <WrapPanel x:Name="MfgContentPanel" AutomationProperties.AutomationId="MfgContentPanel"/>
            <TextBlock Style="{StaticResource MfgCaption}" Text="Property configuration file path in staging (optional, with text below)" Margin="0,8,0,0"/>
            <TextBox x:Name="MfgIpcPropertyPathText" AutomationProperties.AutomationId="MfgIpcPropertyPathText"/>
            <TextBox x:Name="MfgIpcPropertyText" AutomationProperties.AutomationId="MfgIpcPropertyText" Height="40" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="8" Margin="0,4,0,0"/>
            <TextBlock Style="{StaticResource MfgCaption}" Text="Layer-mapping file path in staging (optional, with text below)" Margin="0,8,0,0"/>
            <TextBox x:Name="MfgIpcMappingPathText" AutomationProperties.AutomationId="MfgIpcMappingPathText" Text="ipc-map.cfg"/>
            <TextBox x:Name="MfgIpcMappingText" AutomationProperties.AutomationId="MfgIpcMappingText" Height="56" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="8" Margin="0,4,0,0" Text="TOP, OUTER_COPPER_LAYERS"/>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <StackPanel Margin="0,0,12,0">
              <TextBlock Style="{StaticResource MfgCaption}" Text="Approved root"/>
              <TextBox x:Name="MfgApprovedRootText" AutomationProperties.AutomationId="MfgApprovedRootText" Width="260"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
              <TextBlock Style="{StaticResource MfgCaption}" Text="Destination (relative)"/>
              <TextBox x:Name="MfgDestinationText" AutomationProperties.AutomationId="MfgDestinationText" Width="200" Text="release/fabrication"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Style="{StaticResource MfgCaption}" Text="Timeout (minutes)"/>
              <TextBox x:Name="MfgTimeoutText" AutomationProperties.AutomationId="MfgTimeoutText" Width="100" Text="15"/>
            </StackPanel>
          </StackPanel>
          <CheckBox x:Name="MfgReplaceCheck" AutomationProperties.AutomationId="MfgReplaceCheck" Content="Replace a previous validated destination (otherwise refuse existing)" Margin="0,8,0,0"/>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="MfgBuildPlanButton" AutomationProperties.AutomationId="MfgBuildPlanButton" Content="Build plan and preview manifest" Click="MfgBuildPlanButton_Click"/>
          </StackPanel>
          <TextBlock x:Name="MfgPlanStatusText" AutomationProperties.AutomationId="MfgPlanStatusText" Style="{StaticResource MfgCaption}" Margin="0,8,0,0" Text="No plan built."/>
          <ListBox x:Name="MfgManifestList" AutomationProperties.AutomationId="MfgManifestList" Height="90" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource MfgCard}">
        <StackPanel>
          <TextBlock Text="3 · Generate, validate, promote" FontWeight="Bold" Margin="0,0,0,4"/>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="MfgRunButton" AutomationProperties.AutomationId="MfgRunButton" Content="Generate" Click="MfgRunButton_Click" IsEnabled="False"/>
            <Button x:Name="MfgCancelButton" AutomationProperties.AutomationId="MfgCancelButton" Content="Cancel" Click="MfgCancelButton_Click" IsEnabled="False"/>
            <Button x:Name="MfgPromoteButton" AutomationProperties.AutomationId="MfgPromoteButton" Content="Approve and promote" Click="MfgPromoteButton_Click" IsEnabled="False"/>
            <Button x:Name="MfgReleaseButton" AutomationProperties.AutomationId="MfgReleaseButton" Content="Release staging" Click="MfgReleaseButton_Click" IsEnabled="False"/>
            <Button x:Name="MfgSaveManifestButton" AutomationProperties.AutomationId="MfgSaveManifestButton" Content="Save manifest" Click="MfgSaveManifestButton_Click" IsEnabled="False"/>
          </StackPanel>
          <TextBlock x:Name="MfgActionReasonText" AutomationProperties.AutomationId="MfgActionReasonText" Style="{StaticResource MfgCaption}" Margin="0,8,0,0" Text="Build a plan to enable generation."/>
          <TextBlock x:Name="MfgProgressText" AutomationProperties.AutomationId="MfgProgressText" Style="{StaticResource MfgCaption}" Margin="0,4,0,0" Text=""/>
          <TextBlock Style="{StaticResource MfgCaption}" Text="Result" Margin="0,8,0,0"/>
          <TextBox x:Name="MfgResultText" AutomationProperties.AutomationId="MfgResultText" Height="96" AcceptsReturn="True" IsReadOnly="True" VerticalContentAlignment="Top" Padding="8" TextWrapping="Wrap"/>
          <TextBlock x:Name="MfgPromotionText" AutomationProperties.AutomationId="MfgPromotionText" Style="{StaticResource MfgCaption}" Margin="0,8,0,0" Text=""/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
